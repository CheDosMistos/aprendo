<div class="notation-enhancer-anchor" hidden></div>

<script>
  import { AlphaTabRenderer } from '@platform/notation/AlphaTabRenderer';

  interface StoredMetronomeState { bpm?: number; }
  interface MetronomeBpmEventDetail { bpm?: number; }
  interface StoredNotationView { mode?: 'fit' | 'scroll'; scale?: number; }

  const STORAGE_KEY = 'aprendo-metronome-settings';
  const VIEW_STORAGE_KEY = 'aprendo-notation-view';
  const METRONOME_BPM_EVENT = 'aprendo:metronome-bpm';
  const SCORES_UPDATED_EVENT = 'aprendo:notation-scores-updated';
  const REFERENCE_BPM = 120;
  const MOBILE_QUERY = window.matchMedia('(max-width: 42rem)');
  const renderers: AlphaTabRenderer[] = [];
  let currentBpm = 80;

  const readStoredBpm = () => {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return 80;
      const state = JSON.parse(raw) as StoredMetronomeState;
      return typeof state.bpm === 'number' && Number.isFinite(state.bpm) ? state.bpm : 80;
    } catch {
      return 80;
    }
  };

  const readView = (): Required<StoredNotationView> => {
    const fallback = { mode: 'fit' as const, scale: MOBILE_QUERY.matches ? 0.85 : 1 };
    try {
      const raw = localStorage.getItem(VIEW_STORAGE_KEY);
      if (!raw) return fallback;
      const stored = JSON.parse(raw) as StoredNotationView;
      const mode = stored.mode === 'scroll' ? 'scroll' : 'fit';
      const scale = typeof stored.scale === 'number' && Number.isFinite(stored.scale)
        ? Math.min(1.4, Math.max(0.7, stored.scale))
        : fallback.scale;
      return { mode, scale };
    } catch {
      return fallback;
    }
  };

  const writeView = (view: Required<StoredNotationView>) => {
    try {
      localStorage.setItem(VIEW_STORAGE_KEY, JSON.stringify(view));
    } catch {}
  };

  currentBpm = readStoredBpm();
  let view = readView();

  const make = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string) => {
    const element = document.createElement(tag);
    if (className) element.className = className;
    return element;
  };

  const iconButton = (label: string, title: string, html: string) => {
    const button = make('button', 'course-score__view-button');
    button.type = 'button';
    button.setAttribute('aria-label', label);
    button.title = title;
    button.innerHTML = html;
    return button;
  };

  const enhanceScore = (element: HTMLElement) => {
    if (element.dataset.notationEnhanced === 'true') return;
    const sourceUrl = element.dataset.scoreSrc;
    if (!sourceUrl) return;
    element.dataset.notationEnhanced = 'true';

    element.classList.add('course-score');
    element.dataset.viewMode = view.mode;
    element.replaceChildren();

    const head = make('div', 'course-score__head');
    const headingWrap = make('div', 'course-score__heading');
    const badge = make('p', 'course-score__badge');
    badge.textContent = element.dataset.scoreBadge ?? 'Partitura';
    const title = make('h3', 'course-score__title');
    title.textContent = element.dataset.scoreTitle ?? 'Partitura';
    headingWrap.append(badge, title);

    const headActions = make('div', 'course-score__head-actions');
    const viewControls = make('div', 'course-score__view-controls');
    viewControls.setAttribute('aria-label', 'Controles de visualización de la partitura');

    const fitButton = iconButton('Ajustar partitura al ancho', 'Ajustar al ancho', 'Ajustar');
    fitButton.classList.add('course-score__view-button--text');
    const actualButton = iconButton('Ver partitura al 100%', 'Vista 100% con desplazamiento horizontal', '100%');
    actualButton.classList.add('course-score__view-button--text');
    const zoomOutButton = iconButton('Reducir partitura', 'Reducir', '−');
    const zoomInButton = iconButton('Ampliar partitura', 'Ampliar', '+');
    const fullscreenButton = iconButton(
      'Ver partitura a pantalla completa',
      'Pantalla completa',
      '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H4a1 1 0 0 0-1 1v4M16 3h4a1 1 0 0 1 1 1v4M8 21H4a1 1 0 0 1-1-1v-4M16 21h4a1 1 0 0 0 1-1v-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
    );
    viewControls.append(fitButton, actualButton, zoomOutButton, zoomInButton, fullscreenButton);

    const playButton = make('button', 'course-score__play');
    playButton.type = 'button';
    playButton.disabled = true;
    playButton.setAttribute('aria-pressed', 'false');
    playButton.setAttribute('aria-label', 'Reproducir partitura');
    playButton.title = 'Reproducir partitura al BPM del metrónomo';
    playButton.innerHTML = '<svg class="course-score__play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7Z" fill="currentColor"/></svg><svg class="course-score__pause-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="5" width="4" height="14" rx="1" fill="currentColor"/><rect x="13.5" y="5" width="4" height="14" rx="1" fill="currentColor"/></svg>';
    headActions.append(viewControls, playButton);
    head.append(headingWrap, headActions);

    const shell = make('div', 'course-score__shell');
    shell.setAttribute('tabindex', '0');
    shell.setAttribute('aria-label', 'Partitura. Desliza horizontalmente si hay contenido fuera de pantalla.');
    const host = make('div', 'course-score__host');
    shell.append(host);

    const sourceLink = element.dataset.scoreSourceUrl;
    const isPasScore = sourceUrl.includes('/pas-') || sourceLink?.includes('pas.org');
    const disclaimer = isPasScore ? make('p', 'course-score__disclaimer') : null;
    if (disclaimer) {
      disclaimer.textContent = 'Representación de estudio del curso. PAS International Drum Rudiments © 1984 Percussive Arts Society. La fuente oficial enlazada es la referencia normativa.';
    }

    const footer = make('div', 'course-score__footer');
    const status = make('p', 'course-score__status');
    status.textContent = 'Preparando partitura…';
    status.setAttribute('aria-live', 'polite');
    footer.append(status);

    const links = make('div', 'course-score__links');
    if (sourceLink) {
      const link = make('a');
      link.href = sourceLink;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = element.dataset.scoreSourceLabel ?? 'Abrir fuente';
      links.append(link);
    }
    if (links.childElementCount) footer.append(links);

    element.append(head, shell);
    if (disclaimer) element.append(disclaimer);
    element.append(footer);

    const updateScrollCue = () => {
      const canScroll = shell.scrollWidth > shell.clientWidth + 4;
      const atEnd = shell.scrollLeft + shell.clientWidth >= shell.scrollWidth - 4;
      shell.dataset.scrollable = String(canScroll && !atEnd);
    };

    const applyMode = (mode: 'fit' | 'scroll') => {
      view = { ...view, mode };
      element.dataset.viewMode = mode;
      fitButton.setAttribute('aria-pressed', String(mode === 'fit'));
      actualButton.setAttribute('aria-pressed', String(mode === 'scroll'));
      if (mode === 'fit') shell.scrollLeft = 0;
      writeView(view);
      requestAnimationFrame(updateScrollCue);
    };

    let isPlaying = false;
    const renderer = new AlphaTabRenderer(host, {
      onStatusChange: (state, message) => {
        status.dataset.state = state;
        status.textContent = message ?? state;
        if (state === 'ready') requestAnimationFrame(updateScrollCue);
      },
      onPlaybackReady: (ready) => {
        playButton.disabled = !ready;
        if (ready) renderer.setPlaybackBpm(currentBpm);
      },
      onPlaybackStateChange: (playing) => {
        isPlaying = playing;
        playButton.setAttribute('aria-pressed', String(playing));
        playButton.setAttribute('aria-label', playing ? 'Pausar partitura' : 'Reproducir partitura');
        playButton.title = playing ? 'Pausar partitura' : `Reproducir a ${Math.round(currentBpm)} BPM`;
      },
    }, {
      enablePlayer: true,
      referenceBpm: REFERENCE_BPM,
      displayScale: view.scale,
      stretchForce: MOBILE_QUERY.matches ? 0.62 : 0.8,
      hideScoreHeader: true,
    });

    const applyScale = (nextScale: number) => {
      view = { ...view, scale: Math.min(1.4, Math.max(0.7, Math.round(nextScale * 10) / 10)) };
      renderer.setDisplayScale(view.scale);
      writeView(view);
      requestAnimationFrame(updateScrollCue);
    };

    applyMode(view.mode);
    renderer.setPlaybackBpm(currentBpm);

    fitButton.addEventListener('click', () => applyMode('fit'));
    actualButton.addEventListener('click', () => applyMode('scroll'));
    zoomOutButton.addEventListener('click', () => applyScale(view.scale - 0.1));
    zoomInButton.addEventListener('click', () => applyScale(view.scale + 0.1));
    shell.addEventListener('scroll', updateScrollCue, { passive: true });

    fullscreenButton.addEventListener('click', async () => {
      try {
        if (document.fullscreenElement === element) {
          await document.exitFullscreen();
        } else if (element.requestFullscreen) {
          await element.requestFullscreen();
        }
      } catch {}
    });

    document.addEventListener('fullscreenchange', () => {
      fullscreenButton.setAttribute('aria-label', document.fullscreenElement === element
        ? 'Salir de pantalla completa'
        : 'Ver partitura a pantalla completa');
      requestAnimationFrame(updateScrollCue);
    });

    playButton.addEventListener('click', () => {
      renderer.setPlaybackBpm(currentBpm);
      if (!isPlaying) {
        for (const other of renderers) {
          if (other !== renderer) other.stop();
        }
      }
      renderer.playPause();
    });

    if (!renderer.load(sourceUrl)) {
      status.dataset.state = 'error';
      status.textContent = 'No se ha podido cargar la partitura.';
    }
    renderers.push(renderer);
  };

  const enhanceAllScores = () => {
    for (const element of document.querySelectorAll<HTMLElement>('[data-notation-score]')) enhanceScore(element);
  };

  enhanceAllScores();
  window.addEventListener(SCORES_UPDATED_EVENT, enhanceAllScores);
  document.addEventListener('astro:page-load', enhanceAllScores);
  const scoreObserver = new MutationObserver(enhanceAllScores);
  scoreObserver.observe(document.documentElement, { childList: true, subtree: true });

  window.addEventListener(METRONOME_BPM_EVENT, (event) => {
    const detail = (event as CustomEvent<MetronomeBpmEventDetail>).detail;
    if (typeof detail?.bpm !== 'number' || !Number.isFinite(detail.bpm)) return;
    currentBpm = detail.bpm;
    for (const renderer of renderers) renderer.setPlaybackBpm(currentBpm);
    for (const button of document.querySelectorAll<HTMLButtonElement>('.course-score__play:not([aria-pressed="true"])')) {
      button.title = `Reproducir a ${Math.round(currentBpm)} BPM`;
    }
  });

  window.addEventListener('pagehide', () => {
    scoreObserver.disconnect();
    window.removeEventListener(SCORES_UPDATED_EVENT, enhanceAllScores);
    document.removeEventListener('astro:page-load', enhanceAllScores);
    for (const renderer of renderers) renderer.dispose();
  }, { once: true });
</script>

<style is:global>
  .course-score {
    width: 100%;
    max-width: none;
    margin: 1rem 0 1.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }

  .course-score__head,
  .course-score__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .75rem .9rem;
  }

  .course-score__head {
    border-bottom: 1px solid var(--border);
  }

  .course-score__heading {
    min-width: 0;
  }

  .course-score__badge {
    max-width: none !important;
    margin: 0 0 .15rem !important;
    color: var(--muted) !important;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .045em;
    text-transform: uppercase;
  }

  .course-score__title {
    max-width: none !important;
    margin: 0 !important;
    font-size: 1rem !important;
  }

  .course-score__head-actions,
  .course-score__view-controls {
    display: flex;
    align-items: center;
    gap: .4rem;
  }

  .course-score__view-button,
  .course-score__play {
    height: 2.55rem;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    padding: 0 .72rem;
    border: 1px solid var(--border);
    border-radius: .65rem;
    background: var(--surface-2);
    color: var(--text);
    cursor: pointer;
    font: inherit;
    font-size: .82rem;
    font-weight: 750;
  }

  .course-score__view-button:not(.course-score__view-button--text) {
    width: 2.55rem;
    padding: 0;
    font-size: 1.15rem;
  }

  .course-score__view-button[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .course-score__view-button svg,
  .course-score__play svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .course-score__play {
    width: 2.55rem;
    padding: 0;
    background: var(--accent);
    color: #fff;
  }

  .course-score__play:disabled {
    cursor: wait;
    opacity: .45;
  }

  .course-score__pause-icon {
    display: none;
  }

  .course-score__play[aria-pressed='true'] .course-score__play-icon {
    display: none;
  }

  .course-score__play[aria-pressed='true'] .course-score__pause-icon {
    display: block;
  }

  .course-score__shell {
    width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    -webkit-overflow-scrolling: touch;
    background: #fff;
    scrollbar-gutter: stable;
  }

  .course-score__shell[data-scrollable='true'] {
    box-shadow: inset -1.2rem 0 1rem -1.1rem rgba(17, 24, 39, .45);
  }

  .course-score__host {
    width: 100%;
    min-height: 11rem;
    padding: .45rem .55rem;
    color: #111;
    box-sizing: border-box;
  }

  .course-score[data-view-mode='scroll'] .course-score__host {
    width: 34rem;
    min-width: 34rem;
  }

  .course-score__disclaimer {
    max-width: none !important;
    margin: 1.25rem .9rem !important;
    color: var(--muted) !important;
    font-size: .78rem;
    font-weight: 400 !important;
    line-height: 1.45;
  }

  .course-score__footer {
    min-height: 2.9rem;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .course-score__status {
    max-width: none !important;
    margin: 0 !important;
    font-size: .82rem;
  }

  .course-score__status[data-state='error'] {
    color: #b42318 !important;
  }

  .course-score__links {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    font-size: .82rem;
    font-weight: 700;
  }

  .course-score .at-cursor-bar {
    background: rgba(23, 78, 166, .1);
  }

  .course-score .at-cursor-beat {
    width: 3px;
    background: #174ea6;
  }

  .course-score .at-highlight * {
    fill: #174ea6;
    stroke: #174ea6;
  }

  .course-score:fullscreen {
    width: 100vw;
    height: 100vh;
    margin: 0;
    border: 0;
    border-radius: 0;
    overflow: auto;
    background: var(--surface);
  }

  .course-score:fullscreen .course-score__shell {
    min-height: calc(100vh - 8rem);
  }

  @media (max-width: 42rem) {
    .course-score__head {
      align-items: flex-start;
      flex-wrap: wrap;
      gap: .65rem;
    }

    .course-score__head-actions {
      width: 100%;
      justify-content: space-between;
    }

    .course-score__view-controls {
      min-width: 0;
      overflow-x: auto;
      padding-bottom: .1rem;
    }

    .course-score__view-button,
    .course-score__play {
      height: 2.35rem;
    }

    .course-score__view-button:not(.course-score__view-button--text),
    .course-score__play {
      width: 2.35rem;
    }

    .course-score__host {
      padding: .25rem .2rem;
    }
  }
</style>