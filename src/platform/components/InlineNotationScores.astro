<div class="notation-enhancer-anchor" hidden></div>

<script>
  import { AlphaTabRenderer } from '@platform/notation/AlphaTabRenderer';

  interface StoredMetronomeState { bpm?: number; }
  interface MetronomeBpmEventDetail { bpm?: number; }

  const STORAGE_KEY = 'aprendo-metronome-settings';
  const METRONOME_BPM_EVENT = 'aprendo:metronome-bpm';
  const REFERENCE_BPM = 120;
  const scoreElements = [...document.querySelectorAll<HTMLElement>('[data-notation-score]')];
  const renderers: AlphaTabRenderer[] = [];
  let currentBpm = 80;

  const readStoredBpm = () => {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return 80;
      const state = JSON.parse(raw) as StoredMetronomeState;
      return typeof state.bpm === 'number' && Number.isFinite(state.bpm) ? state.bpm : 80;
    } catch {
      return 80;
    }
  };

  currentBpm = readStoredBpm();

  const make = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string) => {
    const element = document.createElement(tag);
    if (className) element.className = className;
    return element;
  };

  for (const element of scoreElements) {
    const sourceUrl = element.dataset.scoreSrc;
    if (!sourceUrl) continue;

    element.classList.add('course-score');
    element.replaceChildren();

    const head = make('div', 'course-score__head');
    const headingWrap = make('div');
    const badge = make('p', 'course-score__badge');
    badge.textContent = element.dataset.scoreBadge ?? 'Partitura';
    const title = make('h3', 'course-score__title');
    title.textContent = element.dataset.scoreTitle ?? 'Partitura';
    headingWrap.append(badge, title);

    const playButton = make('button', 'course-score__play');
    playButton.type = 'button';
    playButton.disabled = true;
    playButton.setAttribute('aria-pressed', 'false');
    playButton.setAttribute('aria-label', 'Reproducir partitura');
    playButton.title = 'Reproducir partitura al BPM del metrónomo';
    playButton.innerHTML = '<svg class="course-score__play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7Z" fill="currentColor"/></svg><svg class="course-score__pause-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="5" width="4" height="14" rx="1" fill="currentColor"/><rect x="13.5" y="5" width="4" height="14" rx="1" fill="currentColor"/></svg>';
    head.append(headingWrap, playButton);

    const shell = make('div', 'course-score__shell');
    const host = make('div', 'course-score__host');
    shell.append(host);

    const sourceLink = element.dataset.scoreSourceUrl;
    const isPasScore = sourceUrl.includes('/pas-') || sourceLink?.includes('pas.org');
    const disclaimer = isPasScore ? make('p', 'course-score__disclaimer') : null;
    if (disclaimer) {
      disclaimer.textContent = 'Representación de estudio del curso. PAS International Drum Rudiments © 1984 Percussive Arts Society. La fuente oficial enlazada es la referencia normativa.';
    }

    const footer = make('div', 'course-score__footer');
    const status = make('p', 'course-score__status');
    status.textContent = 'Preparando partitura…';
    status.setAttribute('aria-live', 'polite');
    footer.append(status);

    const links = make('div', 'course-score__links');
    if (sourceLink) {
      const link = make('a');
      link.href = sourceLink;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = element.dataset.scoreSourceLabel ?? 'Abrir fuente';
      links.append(link);
    }
    if (links.childElementCount) footer.append(links);

    element.append(head, shell);
    if (disclaimer) element.append(disclaimer);
    element.append(footer);

    let isPlaying = false;
    const renderer = new AlphaTabRenderer(host, {
      onStatusChange: (state, message) => {
        status.dataset.state = state;
        status.textContent = message ?? state;
      },
      onPlaybackReady: (ready) => {
        playButton.disabled = !ready;
        if (ready) renderer.setPlaybackBpm(currentBpm);
      },
      onPlaybackStateChange: (playing) => {
        isPlaying = playing;
        playButton.setAttribute('aria-pressed', String(playing));
        playButton.setAttribute('aria-label', playing ? 'Pausar partitura' : 'Reproducir partitura');
        playButton.title = playing ? 'Pausar partitura' : `Reproducir a ${Math.round(currentBpm)} BPM`;
      },
    }, { enablePlayer: true, referenceBpm: REFERENCE_BPM });

    renderer.setPlaybackBpm(currentBpm);
    playButton.addEventListener('click', () => {
      renderer.setPlaybackBpm(currentBpm);
      if (!isPlaying) {
        for (const other of renderers) {
          if (other !== renderer) other.stop();
        }
      }
      renderer.playPause();
    });

    if (!renderer.load(sourceUrl)) {
      status.dataset.state = 'error';
      status.textContent = 'No se ha podido cargar la partitura.';
    }
    renderers.push(renderer);
  }

  window.addEventListener(METRONOME_BPM_EVENT, (event) => {
    const detail = (event as CustomEvent<MetronomeBpmEventDetail>).detail;
    if (typeof detail?.bpm !== 'number' || !Number.isFinite(detail.bpm)) return;
    currentBpm = detail.bpm;
    for (const renderer of renderers) renderer.setPlaybackBpm(currentBpm);
    for (const button of document.querySelectorAll<HTMLButtonElement>('.course-score__play:not([aria-pressed="true"])')) {
      button.title = `Reproducir a ${Math.round(currentBpm)} BPM`;
    }
  });

  window.addEventListener('pagehide', () => {
    for (const renderer of renderers) renderer.dispose();
  }, { once: true });
</script>

<style is:global>
  .course-score {
    width: 100%;
    max-width: none;
    margin: 1rem 0 1.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }

  .course-score__head,
  .course-score__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .75rem .9rem;
  }

  .course-score__head {
    border-bottom: 1px solid var(--border);
  }

  .course-score__badge {
    max-width: none !important;
    margin: 0 0 .15rem !important;
    color: var(--muted) !important;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .045em;
    text-transform: uppercase;
  }

  .course-score__title {
    max-width: none !important;
    margin: 0 !important;
    font-size: 1rem !important;
  }

  .course-score__play {
    width: 2.55rem;
    height: 2.55rem;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: .65rem;
    background: var(--accent);
    color: #fff;
    cursor: pointer;
  }

  .course-score__play:disabled {
    cursor: wait;
    opacity: .45;
  }

  .course-score__play svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .course-score__pause-icon {
    display: none;
  }

  .course-score__play[aria-pressed='true'] .course-score__play-icon {
    display: none;
  }

  .course-score__play[aria-pressed='true'] .course-score__pause-icon {
    display: block;
  }

  .course-score__shell {
    width: 100%;
    overflow-x: auto;
    background: #fff;
  }

  .course-score__host {
    width: 100%;
    min-height: 11rem;
    padding: .6rem .75rem;
    color: #111;
  }

  .course-score__disclaimer {
    max-width: none !important;
    margin: 1.25rem .9rem !important;
    color: var(--muted) !important;
    font-size: .78rem;
    font-weight: 400 !important;
    line-height: 1.45;
  }

  .course-score__footer {
    min-height: 2.9rem;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .course-score__status {
    max-width: none !important;
    margin: 0 !important;
    font-size: .82rem;
  }

  .course-score__status[data-state='error'] {
    color: #b42318 !important;
  }

  .course-score__links {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    font-size: .82rem;
    font-weight: 700;
  }

  .course-score .at-cursor-bar {
    background: rgba(23, 78, 166, .1);
  }

  .course-score .at-cursor-beat {
    width: 3px;
    background: #174ea6;
  }

  .course-score .at-highlight * {
    fill: #174ea6;
    stroke: #174ea6;
  }

  @media (max-width: 42rem) {
    .course-score__host {
      min-width: 34rem;
      padding: .45rem;
    }
  }
</style>
