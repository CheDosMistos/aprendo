---
interface Props {
  normativeReferenceUrl?: string;
  normativeReferenceLabel?: string;
}

const {
  normativeReferenceUrl,
  normativeReferenceLabel = 'Referencia normativa',
} = Astro.props;
---

{normativeReferenceUrl && (
  <p class="course-score-reference">
    <strong>Referencia normativa de los rudimentos de esta lección:</strong>{' '}
    <a href={normativeReferenceUrl} target="_blank" rel="noopener noreferrer">
      {normativeReferenceLabel}
    </a>
  </p>
)}

<script>
  const applyCourseScoreDataSources = () => {
    let pending = 0;

    for (const score of document.querySelectorAll<HTMLElement>('[data-notation-score]')) {
      const scoreSource = score.dataset.scoreSrc;
      if (!scoreSource) continue;

      const footer = score.querySelector<HTMLElement>('.course-score__footer');
      if (!footer) {
        pending += 1;
        continue;
      }

      let links = footer.querySelector<HTMLElement>('.course-score__links');
      if (!links) {
        links = document.createElement('div');
        links.className = 'course-score__links';
        footer.append(links);
      }

      const absolute = new URL(scoreSource, window.location.href).href;
      const alreadyLinked = [...links.querySelectorAll<HTMLAnchorElement>('a')]
        .some((anchor) => anchor.href === absolute);
      if (alreadyLinked) continue;

      // This is the actual data consumed by AlphaTab. Printable companions and
      // normative external references remain distinct links.
      const link = document.createElement('a');
      link.href = scoreSource;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = 'Abrir fuente MusicXML';
      link.dataset.courseScoreLink = 'data';
      links.append(link);
    }

    return pending;
  };

  const pending = applyCourseScoreDataSources();
  if (pending > 0) {
    const observer = new MutationObserver(() => {
      if (applyCourseScoreDataSources() === 0) observer.disconnect();
    });
    observer.observe(document.body, { childList: true, subtree: true });
  }
</script>

<style>
  .course-score-reference {
    margin: 1.25rem 0 0;
    font-size: 0.95rem;
  }
</style>
