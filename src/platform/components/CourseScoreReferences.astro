---
interface Props {
  normativeReferenceUrl?: string;
  normativeReferenceLabel?: string;
}

const {
  normativeReferenceUrl,
  normativeReferenceLabel = 'Referencia normativa',
} = Astro.props;
---

{normativeReferenceUrl && (
  <span
    hidden
    data-course-score-reference
    data-reference-url={normativeReferenceUrl}
    data-reference-label={normativeReferenceLabel}
  ></span>
)}

<script>
  const appendLink = (
    links: HTMLElement,
    href: string,
    label: string,
    kind: 'data' | 'reference',
  ) => {
    const absolute = new URL(href, window.location.href).href;
    const duplicate = [...links.querySelectorAll<HTMLAnchorElement>('a')]
      .some((anchor) => anchor.href === absolute);
    if (duplicate) return;

    const link = document.createElement('a');
    link.href = href;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.textContent = label;
    link.dataset.courseScoreLink = kind;
    links.append(link);
  };

  const applyCourseScoreReferences = () => {
    const pageReference = document.querySelector<HTMLElement>('[data-course-score-reference]');
    const referenceUrl = pageReference?.dataset.referenceUrl;
    const referenceLabel = pageReference?.dataset.referenceLabel ?? 'Referencia normativa';

    for (const score of document.querySelectorAll<HTMLElement>('[data-notation-score]')) {
      const scoreSource = score.dataset.scoreSrc;
      if (!scoreSource) continue;

      const footer = score.querySelector<HTMLElement>('.course-score__footer');
      if (!footer) continue;

      let links = footer.querySelector<HTMLElement>('.course-score__links');
      if (!links) {
        links = document.createElement('div');
        links.className = 'course-score__links';
        footer.append(links);
      }

      // The MusicXML is the actual data consumed by the score renderer. Keep
      // this distinct from printable companions or normative external sources.
      appendLink(links, scoreSource, 'Abrir fuente MusicXML', 'data');

      if (referenceUrl) {
        appendLink(links, referenceUrl, referenceLabel, 'reference');

        if (referenceUrl.includes('pas.org') && !score.querySelector('.course-score__disclaimer')) {
          const disclaimer = document.createElement('p');
          disclaimer.className = 'course-score__disclaimer';
          disclaimer.textContent = 'Material de estudio original del curso. La notación oficial PAS enlazada es la referencia normativa y prevalece ante cualquier discrepancia.';
          score.insertBefore(disclaimer, footer);
        }
      }
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', applyCourseScoreReferences, { once: true });
  } else {
    applyCourseScoreReferences();
  }
</script>
