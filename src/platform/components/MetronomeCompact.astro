<aside class="metronome" data-metronome aria-label="Metrónomo">
  <div class="metronome-head">
    <h2>Metrónomo</h2>
    <button class="mute-button" type="button" data-mute aria-pressed="false" aria-label="Silenciar metrónomo" title="Silenciar metrónomo">
      <svg class="speaker-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4Z" fill="currentColor"/><path d="M16 9.5a4 4 0 0 1 0 5M18.5 7a7 7 0 0 1 0 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <svg class="speaker-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4Z" fill="currentColor"/><path d="m17 9 5 5m0-5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
  </div>

  <div class="tempo-display">
    <button class="step-button" type="button" data-step="-1" aria-label="Bajar 1 BPM">−</button>
    <label class="bpm-field"><span class="sr-only">BPM</span><input data-bpm type="number" inputmode="numeric" min="30" max="300" step="1" value="80" aria-label="BPM" /><span>BPM</span></label>
    <button class="step-button" type="button" data-step="1" aria-label="Subir 1 BPM">+</button>
  </div>

  <div class="tempo-shortcuts">
    <button type="button" data-half>÷2</button>
    <button class="play-button" type="button" data-play aria-pressed="false"><span data-play-icon>▶</span><span data-play-label>Iniciar</span></button>
    <button type="button" data-double>×2</button>
  </div>

  <select data-preset aria-label="Tempo tradicional">
    <option value="">Personalizado</option><option value="40">Grave · 40</option><option value="50">Largo · 50</option><option value="60">Larghetto · 60</option><option value="66">Adagio · 66</option><option value="76">Andante · 76</option><option value="96">Moderato · 96</option><option value="112">Allegretto · 112</option><option value="144">Allegro · 144</option><option value="168">Vivace · 168</option><option value="184">Presto · 184</option><option value="208">Prestissimo · 208</option>
  </select>

  <div class="two-fields">
    <select data-meter aria-label="Compás"><option>2/4</option><option>3/4</option><option selected>4/4</option><option>5/4</option><option>6/8</option><option>7/8</option></select>
    <select data-subdivision aria-label="Subdivisión"><option value="1">Pulso</option><option value="2">Corcheas</option><option value="3">Tresillos</option><option value="4">Semicorcheas</option></select>
  </div>

  <div class="beat-row" data-beats aria-label="Indicador visual del compás"></div>
  <label class="toggle"><input type="checkbox" data-accent checked /><span>Acentuar primer pulso</span></label>
  <label class="volume-field"><span class="sr-only">Volumen</span><input data-volume type="range" min="0" max="1" step="0.01" value="0.7" aria-label="Volumen" /></label>
</aside>

<script>
  interface StoredMetronomeState { bpm:number; preset:string; meter:string; subdivision:number; accent:boolean; volume:number; muted:boolean; }
  const STORAGE_KEY='aprendo-metronome-settings', MIN_BPM=30, MAX_BPM=300, LOOKAHEAD_MS=25, SCHEDULE_AHEAD_SECONDS=.1;
  const root=document.querySelector<HTMLElement>('[data-metronome]');
  if(root){
    const bpmInput=root.querySelector<HTMLInputElement>('[data-bpm]')!,presetSelect=root.querySelector<HTMLSelectElement>('[data-preset]')!,meterSelect=root.querySelector<HTMLSelectElement>('[data-meter]')!,subdivisionSelect=root.querySelector<HTMLSelectElement>('[data-subdivision]')!,accentInput=root.querySelector<HTMLInputElement>('[data-accent]')!,volumeInput=root.querySelector<HTMLInputElement>('[data-volume]')!,playButton=root.querySelector<HTMLButtonElement>('[data-play]')!,playIcon=root.querySelector<HTMLElement>('[data-play-icon]')!,playLabel=root.querySelector<HTMLElement>('[data-play-label]')!,muteButton=root.querySelector<HTMLButtonElement>('[data-mute]')!,beatsEl=root.querySelector<HTMLElement>('[data-beats]')!;
    let audioContext:AudioContext|null=null,schedulerTimer:number|null=null,isPlaying=false,nextNoteTime=0,beatIndex=0,subdivisionIndex=0;
    const clampBpm=(v:number)=>Math.min(MAX_BPM,Math.max(MIN_BPM,Math.round(v)));
    const meterBeats=()=>{const n=Number.parseInt(meterSelect.value.split('/')[0]??'4',10);return Number.isFinite(n)?n:4;};
    const subdivision=()=>{const v=Number.parseInt(subdivisionSelect.value,10);return [1,2,3,4].includes(v)?v:1;};
    const state=():StoredMetronomeState=>({bpm:clampBpm(Number(bpmInput.value)||80),preset:presetSelect.value,meter:meterSelect.value,subdivision:subdivision(),accent:accentInput.checked,volume:Math.min(1,Math.max(0,Number(volumeInput.value)||0)),muted:muteButton.getAttribute('aria-pressed')==='true'});
    const saveState=()=>{try{localStorage.setItem(STORAGE_KEY,JSON.stringify(state()));}catch{}};
    const restoreState=()=>{try{const raw=localStorage.getItem(STORAGE_KEY);if(!raw)return;const s=JSON.parse(raw) as Partial<StoredMetronomeState>;if(typeof s.bpm==='number')bpmInput.value=String(clampBpm(s.bpm));if(typeof s.preset==='string'&&[...presetSelect.options].some(o=>o.value===s.preset))presetSelect.value=s.preset;if(typeof s.meter==='string'&&[...meterSelect.options].some(o=>o.value===s.meter))meterSelect.value=s.meter;if(typeof s.subdivision==='number'&&[1,2,3,4].includes(s.subdivision))subdivisionSelect.value=String(s.subdivision);if(typeof s.accent==='boolean')accentInput.checked=s.accent;if(typeof s.volume==='number')volumeInput.value=String(Math.min(1,Math.max(0,s.volume)));if(typeof s.muted==='boolean')muteButton.setAttribute('aria-pressed',String(s.muted));}catch{}};
    const updateMute=()=>{const muted=muteButton.getAttribute('aria-pressed')==='true';muteButton.setAttribute('aria-label',muted?'Activar sonido del metrónomo':'Silenciar metrónomo');muteButton.title=muted?'Activar sonido':'Silenciar metrónomo';};
    const renderBeats=()=>{beatsEl.replaceChildren();for(let i=0;i<meterBeats();i+=1){const dot=document.createElement('span');dot.className='beat-dot';dot.dataset.beat=String(i);dot.setAttribute('aria-hidden','true');beatsEl.append(dot);}};
    const setVisualBeat=(i:number)=>{for(const dot of beatsEl.querySelectorAll<HTMLElement>('.beat-dot'))dot.classList.toggle('is-current',Number(dot.dataset.beat)===i);};
    const setBpm=(v:number,clearPreset=true)=>{bpmInput.value=String(clampBpm(v));if(clearPreset)presetSelect.value='';saveState();};
    const scheduleClick=(time:number,beat:number,sub:number)=>{if(!audioContext)return;const muted=muteButton.getAttribute('aria-pressed')==='true',master=muted?0:Number(volumeInput.value),main=sub===0,accent=main&&beat===0&&accentInput.checked,osc=audioContext.createOscillator(),gain=audioContext.createGain();osc.type='square';osc.frequency.value=accent?1320:main?920:620;gain.gain.setValueAtTime(Math.max(.0001,master*(accent?.75:main?.55:.28)),time);gain.gain.exponentialRampToValueAtTime(.0001,time+.035);osc.connect(gain);gain.connect(audioContext.destination);osc.start(time);osc.stop(time+.04);if(main){const delay=Math.max(0,(time-audioContext.currentTime)*1000);window.setTimeout(()=>setVisualBeat(beat),delay);}};
    const advance=()=>{const bpm=clampBpm(Number(bpmInput.value)||80),parts=subdivision();nextNoteTime+=(60/bpm)/parts;subdivisionIndex+=1;if(subdivisionIndex>=parts){subdivisionIndex=0;beatIndex=(beatIndex+1)%meterBeats();}};
    const scheduler=()=>{if(!audioContext||!isPlaying)return;while(nextNoteTime<audioContext.currentTime+SCHEDULE_AHEAD_SECONDS){scheduleClick(nextNoteTime,beatIndex,subdivisionIndex);advance();}};
    const stop=()=>{isPlaying=false;if(schedulerTimer!==null)window.clearInterval(schedulerTimer);schedulerTimer=null;playButton.setAttribute('aria-pressed','false');playIcon.textContent='▶';playLabel.textContent='Iniciar';setVisualBeat(-1);};
    const start=async()=>{if(!audioContext)audioContext=new AudioContext();if(audioContext.state==='suspended')await audioContext.resume();isPlaying=true;beatIndex=0;subdivisionIndex=0;nextNoteTime=audioContext.currentTime+.05;playButton.setAttribute('aria-pressed','true');playIcon.textContent='❚❚';playLabel.textContent='Parar';scheduler();schedulerTimer=window.setInterval(scheduler,LOOKAHEAD_MS);};
    const togglePlayback=()=>{if(isPlaying)stop();else void start();};
    restoreState();updateMute();renderBeats();playButton.addEventListener('click',togglePlayback);
    for(const b of root.querySelectorAll<HTMLButtonElement>('[data-step]'))b.addEventListener('click',()=>setBpm((Number(bpmInput.value)||80)+Number(b.dataset.step)));
    root.querySelector<HTMLButtonElement>('[data-half]')?.addEventListener('click',()=>setBpm((Number(bpmInput.value)||80)/2));root.querySelector<HTMLButtonElement>('[data-double]')?.addEventListener('click',()=>setBpm((Number(bpmInput.value)||80)*2));
    bpmInput.addEventListener('change',()=>setBpm(Number(bpmInput.value)||80));bpmInput.addEventListener('keydown',e=>{if(e.key==='Enter'){setBpm(Number(bpmInput.value)||80);bpmInput.blur();}});
    presetSelect.addEventListener('change',()=>{if(presetSelect.value)bpmInput.value=String(clampBpm(Number(presetSelect.value)));saveState();});meterSelect.addEventListener('change',()=>{beatIndex=0;subdivisionIndex=0;renderBeats();saveState();});subdivisionSelect.addEventListener('change',()=>{subdivisionIndex=0;saveState();});accentInput.addEventListener('change',saveState);volumeInput.addEventListener('input',saveState);
    muteButton.addEventListener('click',()=>{const next=muteButton.getAttribute('aria-pressed')!=='true';muteButton.setAttribute('aria-pressed',String(next));updateMute();saveState();});
    document.addEventListener('keydown',e=>{const target=e.target as HTMLElement|null,editing=target?.matches('input, select, textarea, [contenteditable="true"]');if(editing)return;if(e.code==='Space'){e.preventDefault();togglePlayback();}else if(e.key==='ArrowLeft')setBpm((Number(bpmInput.value)||80)-1);else if(e.key==='ArrowRight')setBpm((Number(bpmInput.value)||80)+1);});window.addEventListener('pagehide',stop);
  }
</script>

<style>
.metronome{width:100%;padding:.8rem;border:1px solid var(--border);border-radius:.9rem;background:var(--surface);box-shadow:0 .6rem 1.6rem rgba(0,0,0,.08);color:var(--text)}.metronome-head{display:flex;align-items:center;justify-content:space-between;gap:.75rem;margin-bottom:.55rem}.metronome h2{margin:0;font-size:1.05rem}.mute-button{width:2.25rem;height:2.25rem;display:grid;place-items:center;padding:0;border:1px solid var(--border);border-radius:.65rem;background:var(--surface-2);color:var(--text);cursor:pointer}.mute-button svg{width:1.2rem;height:1.2rem}.speaker-off{display:none}.mute-button[aria-pressed="true"] .speaker-on{display:none}.mute-button[aria-pressed="true"] .speaker-off{display:block}.tempo-display{display:grid;grid-template-columns:2.45rem 1fr 2.45rem;align-items:center;gap:.45rem}.step-button,.tempo-shortcuts button{min-height:2.4rem;border:1px solid var(--border);border-radius:.65rem;background:var(--surface-2);color:var(--text);font-weight:800;cursor:pointer}.bpm-field{display:grid;justify-items:center}.bpm-field input{width:100%;padding:0;border:0;background:transparent;color:var(--text);font:800 clamp(2.2rem,5vw,3rem)/1 system-ui;text-align:center;-moz-appearance:textfield}.bpm-field input::-webkit-outer-spin-button,.bpm-field input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}.bpm-field>span:last-child{margin-top:.1rem;color:var(--muted);font-size:.7rem;font-weight:800}.tempo-shortcuts{display:grid;grid-template-columns:.7fr 1.35fr .7fr;gap:.45rem;margin:.55rem 0}.play-button{background:var(--accent)!important;color:#fff!important;border-color:transparent!important}select{width:100%;min-height:2.35rem;padding:.35rem .55rem;border:1px solid var(--border);border-radius:.6rem;background:var(--surface-2);color:var(--text)}.two-fields{display:grid;grid-template-columns:1fr 1fr;gap:.45rem;margin-top:.45rem}.beat-row{min-height:1.15rem;display:flex;justify-content:center;align-items:center;gap:.45rem;margin:.55rem 0}.beat-row :global(.beat-dot){width:.55rem;height:.55rem;border-radius:50%;background:var(--border);transition:transform .06s ease,background .06s ease}.beat-row :global(.beat-dot.is-current){background:var(--accent);transform:scale(1.35)}.toggle{display:flex;align-items:center;gap:.45rem;font-size:.82rem}.toggle input{accent-color:var(--accent)}.volume-field{display:block;margin-top:.55rem}.volume-field input{width:100%;margin:0;accent-color:var(--accent)}@media(max-width:56rem){.metronome{max-width:34rem}}
</style>
