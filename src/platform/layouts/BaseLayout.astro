---
import '@platform/styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Aprendo, plataforma personal de aprendizaje.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem('aprendo-theme');
          if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Aprendo, inicio">
          <svg class="brand-star" aria-hidden="true"><use href="/ui/icons.svg#star"></use></svg>
          <span>Aprendo</span>
        </a>
        <div class="header-actions">
          <nav aria-label="Principal">
            <a href="/bateria/">Batería</a>
          </nav>
          <button class="metronome-toggle" type="button" data-metronome-toggle aria-controls="course-metronome-panel" aria-expanded="false" aria-label="Mostrar herramientas de práctica" title="Herramientas de práctica" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8.2 3.5h7.6L19 20.5H5L8.2 3.5Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              <path d="M12 6.2 9.7 15.4M9 16.5h6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
              <circle cx="9.55" cy="15.8" r="1.15" fill="currentColor"/>
            </svg>
          </button>
          <button class="fullscreen-button" type="button" data-fullscreen title="Pantalla completa" aria-label="Entrar en pantalla completa" aria-pressed="false">
            <svg class="fullscreen-enter" aria-hidden="true" viewBox="0 0 24 24"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <svg class="fullscreen-exit" aria-hidden="true" viewBox="0 0 24 24"><path d="M8 8H3V3M16 8h5V3M8 16H3v5M16 16h5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </header>

    <main class="container main-content">
      <slot />
    </main>

    {Astro.slots.has('footer') && (
      <footer class="site-footer">
        <div class="container footer-inner">
          <slot name="footer" />
        </div>
      </footer>
    )}

    <script>
      const fullscreenButton = document.querySelector<HTMLButtonElement>('[data-fullscreen]');
      const metronomeToggle = document.querySelector<HTMLButtonElement>('[data-metronome-toggle]');
      const metronomePanel = document.querySelector<HTMLElement>('#course-metronome-panel');
      const metronomeBackdrop = document.querySelector<HTMLButtonElement>('[data-metronome-backdrop]');
      const compactMetronomeMedia = window.matchMedia('(max-width: 56rem)');

      const syncFullscreenButton = () => {
        if (!fullscreenButton) return;
        const active = Boolean(document.fullscreenElement);
        fullscreenButton.setAttribute('aria-pressed', String(active));
        fullscreenButton.setAttribute('aria-label', active ? 'Salir de pantalla completa' : 'Entrar en pantalla completa');
        fullscreenButton.title = active ? 'Salir de pantalla completa' : 'Pantalla completa';
      };

      const setMetronomeOpen = (open: boolean) => {
        if (!metronomeToggle || !metronomePanel) return;
        const canFloat = compactMetronomeMedia.matches;
        const next = open && canFloat;
        metronomePanel.classList.toggle('is-mobile-open', next);
        metronomeBackdrop?.classList.toggle('is-open', next);
        metronomeToggle.setAttribute('aria-expanded', String(next));
        metronomeToggle.setAttribute('aria-label', next ? 'Ocultar herramientas de práctica' : 'Mostrar herramientas de práctica');
        metronomeToggle.title = next ? 'Ocultar herramientas de práctica' : 'Herramientas de práctica';
      };

      const syncMetronomeToggle = () => {
        if (!metronomeToggle) return;
        const available = Boolean(metronomePanel) && compactMetronomeMedia.matches;
        metronomeToggle.hidden = !available;
        if (!available) setMetronomeOpen(false);
      };

      if (metronomeToggle && metronomePanel) {
        metronomeToggle.addEventListener('click', () => {
          setMetronomeOpen(metronomeToggle.getAttribute('aria-expanded') !== 'true');
        });
        metronomeBackdrop?.addEventListener('click', () => setMetronomeOpen(false));
        compactMetronomeMedia.addEventListener('change', syncMetronomeToggle);
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && metronomeToggle.getAttribute('aria-expanded') === 'true') {
            setMetronomeOpen(false);
            metronomeToggle.focus();
          }
        });
        syncMetronomeToggle();
      }

      if (fullscreenButton) {
        if (!document.fullscreenEnabled) {
          fullscreenButton.hidden = true;
        } else {
          fullscreenButton.addEventListener('click', async () => {
            try {
              if (document.fullscreenElement) await document.exitFullscreen();
              else await document.documentElement.requestFullscreen();
            } catch {
              // El navegador puede denegar fullscreen fuera de un gesto válido.
            }
          });
          document.addEventListener('fullscreenchange', syncFullscreenButton);
          syncFullscreenButton();
        }
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    min-height: 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text);
    font-size: 1.1rem;
    font-weight: 800;
    text-decoration: none;
  }

  .brand-star {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    background: url('/favicon.svg') center / contain no-repeat;
    color: transparent;
  }

  .brand-star use {
    display: none;
  }

  .header-actions,
  nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  nav a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    color: var(--text);
  }

  .fullscreen-button,
  .metronome-toggle {
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    background: var(--surface-2);
    color: var(--text);
    cursor: pointer;
  }

  .fullscreen-button { display: grid; }
  .metronome-toggle { display: none; }

  .fullscreen-button:hover,
  .metronome-toggle:hover,
  .metronome-toggle[aria-expanded='true'] {
    background: var(--surface);
  }

  .fullscreen-button svg,
  .metronome-toggle svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .fullscreen-exit { display: none; }
  .fullscreen-button[aria-pressed='true'] .fullscreen-enter { display: none; }
  .fullscreen-button[aria-pressed='true'] .fullscreen-exit { display: block; }

  .main-content {
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
  }

  .footer-inner {
    min-height: 4rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-block: 0.65rem;
  }

  @media (max-width: 56rem) {
    .metronome-toggle:not([hidden]) { display: grid; }
  }

  @media (max-width: 42rem) {
    nav { display: none; }
    .header-actions { gap: .5rem; }
  }
</style>
