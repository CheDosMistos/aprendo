---
import '@platform/styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Aprendo, plataforma personal de aprendizaje.',
} = Astro.props;
const user = Astro.locals.user;
const avatarUrl = user?.avatarVersion ? `/api/account/avatar/?v=${encodeURIComponent(user.avatarVersion)}` : '';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <link rel="stylesheet" href="/home/home-polish.css" />
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem('aprendo-theme');
          if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
        } catch {}
      })();
    </script>
  </head>
  <body class="home-body" data-account-avatar={avatarUrl}>
    <main class="home-main">
      <slot />
    </main>
    <script>
      const avatarButton = document.querySelector<HTMLAnchorElement>('.avatar-button');
      if (avatarButton) {
        avatarButton.href = '/cuenta/';
        avatarButton.removeAttribute('aria-disabled');
        avatarButton.title = 'Mi cuenta';
        avatarButton.classList.remove('inactive-link');
        const sr = avatarButton.querySelector<HTMLElement>('.sr-only');
        if (sr) sr.textContent = 'Mi cuenta';
        avatarButton.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopImmediatePropagation();
          window.location.assign('/cuenta/');
        }, { capture: true });
        const avatarUrl = document.body.dataset.accountAvatar;
        if (avatarUrl) {
          const image = document.createElement('img');
          image.src = avatarUrl;
          image.alt = '';
          image.width = 46;
          image.height = 46;
          image.style.cssText = 'width:100%;height:100%;display:block;object-fit:cover;border-radius:50%';
          avatarButton.replaceChildren(image);
        }
      }
    </script>
  </body>
</html>

<style>
  :global(body.home-body) {
    display: block;
    background: #0c0b10;
  }

  :global(.home-header .icon-button),
  :global(.home-header .avatar-button) {
    border: 0 !important;
  }

  .home-main {
    min-height: 100vh;
  }
</style>