<script>
  import { preloadNotationResources } from '@platform/notation/notationPreload';

  type AudioContextCtor = typeof AudioContext;
  type Layer = 'low' | 'mid' | 'high';

  const setupRhythmTranscriptions = () => {
    const widgets = document.querySelectorAll<HTMLElement>('[data-rhythm-transcription]');

    for (const widget of widgets) {
      if (widget.dataset.ready === 'true') continue;
      widget.dataset.ready = 'true';

      const bpm = Number(widget.dataset.bpm ?? '72');
      const subdivision = Number(widget.dataset.subdivision ?? '2');
      const patterns: Record<Layer, string> = {
        low: (widget.dataset.lowPattern ?? '').trim(),
        mid: (widget.dataset.midPattern ?? '').trim(),
        high: (widget.dataset.highPattern ?? '').trim(),
      };
      const patternLength = patterns.low.length;
      const validPatterns = patternLength > 0 && patterns.mid.length === patternLength && patterns.high.length === patternLength;
      const answer = widget.dataset.answer ?? '';
      const answerScoreSrc = widget.dataset.answerScoreSrc ?? '';
      const answerScoreTitle = widget.dataset.answerScoreTitle ?? 'Esqueleto de solución';
      const allowSlowdown = widget.dataset.allowSlowdown === 'true';
      const chunkBeats = Number(widget.dataset.chunkBeats ?? '0');
      const requestedChunkLabels = (widget.dataset.chunkLabels ?? '')
        .split('|')
        .map((label) => label.trim())
        .filter(Boolean);
      const chunkSlots = Number.isInteger(chunkBeats) && chunkBeats > 0 && Number.isInteger(subdivision) && subdivision > 0
        ? chunkBeats * subdivision
        : 0;
      const hasChunks = validPatterns && chunkSlots > 0 && patternLength > chunkSlots && patternLength % chunkSlots === 0;
      const chunkCount = hasChunks ? patternLength / chunkSlots : 0;
      const chunkLabels = Array.from({ length: chunkCount }, (_, index) => requestedChunkLabels[index] ?? `Chunk ${index + 1}`);
      const stimulusBeats = validPatterns && subdivision > 0 ? patternLength / subdivision : Number.NaN;
      const stimulusLabel = stimulusBeats === 8 ? '2 compases' : stimulusBeats === 4 ? '1 compás' : `${stimulusBeats} pulsos`;

      let fullCount = 0;
      let chunkCountTotal = 0;
      let slowCount = 0;
      const chunkCounts = Array.from({ length: chunkCount }, () => 0);
      widget.dataset.fullListenCount = '0';
      widget.dataset.chunkListenCount = '0';
      widget.dataset.slowListenCount = '0';
      widget.classList.add('rhythm-transcription');

      const chunkMarkup = hasChunks
        ? `<div class="rhythm-transcription__chunks"><span>Ayuda por partes</span>${chunkLabels.map((label, index) => `<button type="button" data-transcription-chunk data-chunk-index="${index}" disabled>${label} · 0</button>`).join('')}</div>`
        : '';
      const slowdownMarkup = allowSlowdown
        ? '<button type="button" data-transcription-slow disabled>Escuchar al 80 %</button>'
        : '';

      widget.innerHTML = `<div class="rhythm-transcription__controls"><button type="button" data-transcription-play>Escuchar fuente al 100 %</button>${slowdownMarkup}<button type="button" data-transcription-answer>Mostrar solución</button></div>${chunkMarkup}<p class="rhythm-transcription__status" data-transcription-status>4 pulsos de entrada y después ${stimulusLabel}. Conserva tu primera hipótesis antes de revelar.</p><p class="rhythm-transcription__counts" data-transcription-counts>100 %: 0${hasChunks ? ' · chunks: 0' : ''}${allowSlowdown ? ' · 80 %: 0' : ''}</p><p class="rhythm-transcription__answer" data-transcription-answer-text hidden></p>`;

      const playFull = widget.querySelector<HTMLButtonElement>('[data-transcription-play]');
      const playSlow = widget.querySelector<HTMLButtonElement>('[data-transcription-slow]');
      const reveal = widget.querySelector<HTMLButtonElement>('[data-transcription-answer]');
      const status = widget.querySelector<HTMLElement>('[data-transcription-status]');
      const counts = widget.querySelector<HTMLElement>('[data-transcription-counts]');
      const answerText = widget.querySelector<HTMLElement>('[data-transcription-answer-text]');
      const chunkButtons = [...widget.querySelectorAll<HTMLButtonElement>('[data-transcription-chunk]')];

      if (answerScoreSrc) preloadNotationResources([answerScoreSrc]);
      let answerScore: HTMLDivElement | null = null;

      const ensureAnswerScore = () => {
        if (!answerScoreSrc) return null;
        if (answerScore) return answerScore;
        answerScore = document.createElement('div');
        answerScore.setAttribute('data-transcription-answer-score', '');
        answerScore.setAttribute('data-notation-score', '');
        answerScore.dataset.scoreSrc = answerScoreSrc;
        answerScore.dataset.scoreTitle = answerScoreTitle;
        answerScore.dataset.scoreBadge = 'EJERCICIO ORIGINAL CREADO PARA ESTE CURSO';
        answerScore.dataset.scoreSourceUrl = answerScoreSrc;
        answerScore.dataset.scoreSourceLabel = 'MusicXML — esqueleto original de la fuente';
        widget.append(answerScore);
        return answerScore;
      };

      const updateCounts = () => {
        widget.dataset.fullListenCount = String(fullCount);
        widget.dataset.chunkListenCount = String(chunkCountTotal);
        widget.dataset.slowListenCount = String(slowCount);
        if (counts) counts.textContent = `100 %: ${fullCount}${hasChunks ? ` · chunks: ${chunkCountTotal}` : ''}${allowSlowdown ? ` · 80 %: ${slowCount}` : ''}`;
        chunkButtons.forEach((button, index) => {
          button.textContent = `${chunkLabels[index]} · ${chunkCounts[index] ?? 0}`;
        });
      };

      const tone = (context: AudioContext, time: number, layer: Layer) => {
        const oscillator = context.createOscillator();
        const gain = context.createGain();
        if (layer === 'low') {
          oscillator.type = 'sine';
          oscillator.frequency.setValueAtTime(105, time);
          oscillator.frequency.exponentialRampToValueAtTime(58, time + 0.075);
        } else if (layer === 'mid') {
          oscillator.type = 'square';
          oscillator.frequency.value = 430;
        } else {
          oscillator.type = 'triangle';
          oscillator.frequency.value = 2100;
        }
        const level = layer === 'low' ? 0.19 : layer === 'mid' ? 0.11 : 0.065;
        const duration = layer === 'high' ? 0.035 : 0.075;
        gain.gain.setValueAtTime(level, time);
        gain.gain.exponentialRampToValueAtTime(0.0001, time + duration);
        oscillator.connect(gain).connect(context.destination);
        oscillator.start(time);
        oscillator.stop(time + duration + 0.01);
      };

      const metronomeClick = (context: AudioContext, time: number, first: boolean) => {
        const oscillator = context.createOscillator();
        const gain = context.createGain();
        oscillator.type = 'sine';
        oscillator.frequency.value = first ? 1100 : 880;
        gain.gain.setValueAtTime(0.09, time);
        gain.gain.exponentialRampToValueAtTime(0.0001, time + 0.04);
        oscillator.connect(gain).connect(context.destination);
        oscillator.start(time);
        oscillator.stop(time + 0.05);
      };

      const play = async (rate: number, mode: 'full' | 'chunk', chunkIndex = -1) => {
        if (!validPatterns || !Number.isFinite(bpm) || bpm <= 0 || !Number.isInteger(subdivision) || subdivision <= 0) {
          if (status) status.textContent = 'La fuente no está configurada correctamente.';
          return;
        }

        const Ctor = window.AudioContext || (window as unknown as { webkitAudioContext?: AudioContextCtor }).webkitAudioContext;
        if (!Ctor) {
          if (status) status.textContent = 'Tu navegador no ofrece Web Audio.';
          return;
        }

        const context = new Ctor();
        await context.resume();
        const effectiveBpm = bpm * rate;
        const quarter = 60 / effectiveBpm;
        const slot = quarter / subdivision;
        const start = context.currentTime + 0.08;

        if (mode === 'full' && rate === 1) {
          fullCount += 1;
          if (fullCount === 1) {
            chunkButtons.forEach((button) => { button.disabled = false; });
            if (playSlow) playSlow.disabled = false;
          }
        } else if (mode === 'full') {
          slowCount += 1;
        } else if (chunkIndex >= 0 && chunkIndex < chunkCounts.length) {
          chunkCountTotal += 1;
          chunkCounts[chunkIndex] = (chunkCounts[chunkIndex] ?? 0) + 1;
        }
        updateCounts();

        for (let beat = 0; beat < 4; beat += 1) metronomeClick(context, start + beat * quarter, beat === 0);
        const phraseStart = start + 4 * quarter;
        const from = mode === 'chunk' ? chunkIndex * chunkSlots : 0;
        const to = mode === 'chunk' ? from + chunkSlots : patternLength;
        const layers: Layer[] = ['low', 'mid', 'high'];
        for (let index = from; index < to; index += 1) {
          const localIndex = mode === 'chunk' ? index - from : index;
          for (const layer of layers) {
            if (patterns[layer][index] === '1') tone(context, phraseStart + localIndex * slot, layer);
          }
        }

        if (status) {
          if (mode === 'chunk') status.textContent = `Ayuda utilizada: ${chunkLabels[chunkIndex]}. Formula qué querías comprobar y vuelve después a la fuente completa.`;
          else if (rate < 1) status.textContent = 'Reproducción al 80 % registrada como ayuda. Revisa tu hipótesis y vuelve a 100 % antes de validar.';
          else status.textContent = 'Fuente al 100 %. Conserva tu hipótesis y elige una pregunta concreta antes de reescuchar.';
        }
        const slotsPlayed = mode === 'chunk' ? chunkSlots : patternLength;
        window.setTimeout(() => void context.close(), Math.ceil((4 * quarter + slotsPlayed * slot + 0.5) * 1000));
      };

      playFull?.addEventListener('click', () => void play(1, 'full'));
      playSlow?.addEventListener('click', () => void play(0.8, 'full'));
      chunkButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const index = Number(button.dataset.chunkIndex ?? '-1');
          if (!Number.isInteger(index) || index < 0) return;
          void play(1, 'chunk', index);
        });
      });

      reveal?.addEventListener('click', () => {
        if (!answerText) return;
        const showing = answerText.hidden;
        answerText.hidden = !showing;
        answerText.textContent = showing ? answer : '';
        if (showing) {
          const score = ensureAnswerScore();
          if (score) score.hidden = false;
        } else if (answerScore) {
          answerScore.hidden = true;
        }
        reveal.textContent = showing ? 'Ocultar solución' : 'Mostrar solución';
      });
    }
  };

  setupRhythmTranscriptions();
  document.addEventListener('astro:page-load', setupRhythmTranscriptions);
</script>

<style is:global>
  .rhythm-transcription{max-width:52rem;margin:1.25rem 0;padding:1rem;border:1px solid var(--border);border-radius:.85rem;background:var(--surface-2)}
  .rhythm-transcription__controls,.rhythm-transcription__chunks{display:flex;flex-wrap:wrap;align-items:center;gap:.65rem}
  .rhythm-transcription__chunks{margin-top:.75rem;padding-top:.75rem;border-top:1px solid var(--border)}
  .rhythm-transcription__chunks span{width:100%;font-size:.9rem;font-weight:700;color:var(--muted)}
  .rhythm-transcription button{min-height:2.6rem;padding:.55rem .8rem;border:1px solid var(--border);border-radius:.6rem;background:var(--surface);color:var(--text);font:inherit;font-weight:650;cursor:pointer}
  .rhythm-transcription button:disabled{cursor:not-allowed;opacity:.5}
  .rhythm-transcription__status,.rhythm-transcription__counts,.rhythm-transcription__answer{margin:.75rem 0 0;color:var(--muted)}
  .rhythm-transcription__counts{font-size:.9rem;font-variant-numeric:tabular-nums}
  .rhythm-transcription__answer{white-space:pre-line;font-weight:650;color:var(--text)}
  .rhythm-transcription [data-transcription-answer-score]{max-width:none;margin-top:1rem}
</style>
