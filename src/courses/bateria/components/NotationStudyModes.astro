<div hidden aria-hidden="true"></div>

<script>
  const ENHANCED = 'studyModeEnhanced';

  const enhanceScore = (score: HTMLElement) => {
    if (score.dataset[ENHANCED] === 'true') return;
    const controls = score.querySelector<HTMLElement>('.course-score__view-controls');
    const shell = score.querySelector<HTMLElement>('.course-score__shell');
    if (!controls || !shell) return;

    const firstSight = score.dataset.scoreFirstSight === 'true';
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'course-score__study-toggle course-score__view-button course-score__view-button--text';
    button.textContent = firstSight ? 'Empezar' : 'Ocultar';
    button.title = firstSight
      ? 'Revelar por primera vez la notación e iniciar el intento de lectura'
      : 'Ocultar la notación para intentar recordar, cantar o tocar antes de comprobar';
    button.setAttribute('aria-pressed', firstSight ? 'true' : 'false');

    const setHidden = (hidden: boolean) => {
      score.dataset.studyHidden = String(hidden);
      button.setAttribute('aria-pressed', String(hidden));
      shell.setAttribute('aria-hidden', String(hidden));
    };

    if (firstSight) {
      score.dataset.studyFirstSight = 'true';
      setHidden(true);
    }

    button.addEventListener('click', () => {
      if (firstSight && score.dataset.firstSightStarted !== 'true') {
        score.dataset.firstSightStarted = 'true';
        setHidden(false);
        button.textContent = 'Ocultar';
        button.title = 'Ocultar la notación antes de otro intento de recuperación';
        return;
      }

      const hidden = score.dataset.studyHidden !== 'true';
      setHidden(hidden);
      button.textContent = hidden ? 'Revelar' : 'Ocultar';
      button.title = hidden ? 'Revelar la notación y comprobar el intento' : 'Ocultar la notación antes de intentar';
    });

    controls.prepend(button);
    score.dataset[ENHANCED] = 'true';
  };

  const enhanceAll = () => {
    for (const score of document.querySelectorAll<HTMLElement>('.course-score')) enhanceScore(score);
  };

  enhanceAll();
  document.addEventListener('astro:page-load', enhanceAll);
  const observer = new MutationObserver(enhanceAll);
  observer.observe(document.documentElement, { childList: true, subtree: true });
</script>

<style is:global>
  .course-score[data-study-hidden='true'] .course-score__shell {
    position: relative;
    min-height: 7rem;
    overflow: hidden;
    background: var(--surface-2);
  }
  .course-score[data-study-hidden='true'] .course-score__shell > * {
    visibility: hidden;
  }
  .course-score[data-study-hidden='true'] .course-score__shell::after {
    content: 'Notación oculta · intenta contar, cantar o tocar antes de revelar';
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    color: var(--muted);
    text-align: center;
    font-weight: 700;
  }
  .course-score[data-score-first-sight='true'][data-study-hidden='true']:not([data-first-sight-started='true']) .course-score__shell::after {
    content: 'Primera vista · pulsa Empezar cuando estés preparado para ver la partitura';
  }
  .course-score[data-score-first-sight='true']:not([data-first-sight-started='true']) .course-score__play {
    display: none;
  }
</style>
