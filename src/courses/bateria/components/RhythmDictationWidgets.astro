<script>
  import { preloadNotationResources } from '@platform/notation/notationPreload';

  type AudioContextCtor = typeof AudioContext;

  const setupRhythmDictations = () => {
    const widgets = document.querySelectorAll<HTMLElement>('[data-rhythm-dictation]');

    for (const widget of widgets) {
      if (widget.dataset.ready === 'true') continue;
      widget.dataset.ready = 'true';

      const bpm = Number(widget.dataset.bpm ?? '72');
      const subdivision = Number(widget.dataset.subdivision ?? '2');
      const pattern = (widget.dataset.pattern ?? '').trim();
      const answer = widget.dataset.answer ?? '';
      const answerScoreSrc = widget.dataset.answerScoreSrc ?? '';
      const answerScoreTitle = widget.dataset.answerScoreTitle ?? 'Solución escrita';
      const chunkBeats = Number(widget.dataset.chunkBeats ?? '0');
      const requestedChunkLabels = (widget.dataset.chunkLabels ?? '')
        .split('|')
        .map((label) => label.trim())
        .filter(Boolean);
      const stimulusBeats = Number.isInteger(subdivision) && subdivision > 0 && pattern
        ? pattern.length / subdivision
        : Number.NaN;
      const stimulusLabel = Number.isFinite(stimulusBeats) && stimulusBeats > 0
        ? stimulusBeats === 4
          ? '1 compás'
          : stimulusBeats === 8
            ? '2 compases'
            : stimulusBeats === 1
              ? '1 pulso'
              : `${stimulusBeats} pulsos`
        : 'el estímulo';
      const chunkSlots = Number.isInteger(chunkBeats) && chunkBeats > 0 && Number.isInteger(subdivision) && subdivision > 0
        ? chunkBeats * subdivision
        : 0;
      const hasChunks = chunkSlots > 0 && pattern.length > chunkSlots && pattern.length % chunkSlots === 0;
      const chunkPatterns = hasChunks
        ? Array.from({ length: pattern.length / chunkSlots }, (_, index) => pattern.slice(index * chunkSlots, (index + 1) * chunkSlots))
        : [];
      const chunkLabels = chunkPatterns.map((_, index) => requestedChunkLabels[index] ?? (chunkBeats === 4 ? `Compás ${index + 1}` : `Chunk ${index + 1}`));

      let listenCount = 0;
      let chunkListenCount = 0;
      const chunkListenCounts = chunkPatterns.map(() => 0);
      widget.dataset.listenCount = '0';
      widget.dataset.chunkListenCount = '0';
      widget.classList.add('rhythm-dictation');

      const chunkMarkup = hasChunks
        ? `<div class="rhythm-dictation__chunks" data-dictation-chunks><span class="rhythm-dictation__chunks-label">Ayuda por partes</span>${chunkLabels.map((label, index) => `<button type="button" data-dictation-chunk-play data-chunk-index="${index}" disabled>${label} · 0</button>`).join('')}</div>`
        : '';
      const counterMarkup = hasChunks
        ? '<p class="rhythm-dictation__listens" data-dictation-listen-count>Escuchas completas: 0 · chunks: 0</p>'
        : '<p class="rhythm-dictation__listens" data-dictation-listen-count>Escuchas: 0</p>';

      widget.innerHTML = `<div class="rhythm-dictation__controls"><button type="button" data-dictation-play>Escuchar dictado</button><button type="button" data-dictation-answer>Mostrar respuesta</button></div>${chunkMarkup}<p class="rhythm-dictation__status" data-dictation-status>4 pulsos de entrada y después ${stimulusLabel}. Escribe antes de revelar.</p>${counterMarkup}<p class="rhythm-dictation__answer" data-dictation-answer-text hidden></p>`;

      const play = widget.querySelector<HTMLButtonElement>('[data-dictation-play]');
      const reveal = widget.querySelector<HTMLButtonElement>('[data-dictation-answer]');
      const status = widget.querySelector<HTMLElement>('[data-dictation-status]');
      const listenCountText = widget.querySelector<HTMLElement>('[data-dictation-listen-count]');
      const answerText = widget.querySelector<HTMLElement>('[data-dictation-answer-text]');
      const chunkButtons = [...widget.querySelectorAll<HTMLButtonElement>('[data-dictation-chunk-play]')];

      if (answerScoreSrc) preloadNotationResources([answerScoreSrc]);
      let answerScore: HTMLDivElement | null = null;

      const ensureAnswerScore = () => {
        if (!answerScoreSrc) return null;
        if (answerScore) return answerScore;
        answerScore = document.createElement('div');
        answerScore.setAttribute('data-dictation-answer-score', '');
        answerScore.setAttribute('data-notation-score', '');
        answerScore.dataset.scoreSrc = answerScoreSrc;
        answerScore.dataset.scoreTitle = answerScoreTitle;
        answerScore.dataset.scoreBadge = 'EJERCICIO ORIGINAL CREADO PARA ESTE CURSO';
        answerScore.dataset.scoreSourceUrl = answerScoreSrc;
        answerScore.dataset.scoreSourceLabel = 'MusicXML — fuente del ejercicio original';
        widget.append(answerScore);
        return answerScore;
      };

      const updateCounters = () => {
        widget.dataset.listenCount = String(listenCount);
        widget.dataset.chunkListenCount = String(chunkListenCount);
        if (listenCountText) {
          listenCountText.textContent = hasChunks
            ? `Escuchas completas: ${listenCount} · chunks: ${chunkListenCount}`
            : `Escuchas: ${listenCount}`;
        }
        chunkButtons.forEach((button, index) => {
          button.textContent = `${chunkLabels[index]} · ${chunkListenCounts[index] ?? 0}`;
        });
      };

      const playPattern = async (playedPattern: string, mode: 'full' | 'chunk', chunkIndex = -1) => {
        if (!playedPattern || !Number.isFinite(bpm) || bpm <= 0 || !Number.isInteger(subdivision) || subdivision <= 0) {
          if (status) status.textContent = 'El dictado no está configurado correctamente.';
          return;
        }

        const Ctor = window.AudioContext || (window as unknown as { webkitAudioContext?: AudioContextCtor }).webkitAudioContext;
        if (!Ctor) {
          if (status) status.textContent = 'Tu navegador no ofrece Web Audio.';
          return;
        }

        const context = new Ctor();
        await context.resume();

        if (mode === 'full') {
          listenCount += 1;
          if (listenCount === 1) chunkButtons.forEach((button) => { button.disabled = false; });
        } else if (chunkIndex >= 0 && chunkIndex < chunkListenCounts.length) {
          chunkListenCount += 1;
          chunkListenCounts[chunkIndex] = (chunkListenCounts[chunkIndex] ?? 0) + 1;
        }
        updateCounters();

        const quarter = 60 / bpm;
        const slot = quarter / subdivision;
        const start = context.currentTime + 0.08;

        const click = (time: number, frequency: number, gainValue: number) => {
          const osc = context.createOscillator();
          const gain = context.createGain();
          osc.frequency.value = frequency;
          gain.gain.setValueAtTime(gainValue, time);
          gain.gain.exponentialRampToValueAtTime(0.0001, time + 0.045);
          osc.connect(gain).connect(context.destination);
          osc.start(time);
          osc.stop(time + 0.05);
        };

        for (let beat = 0; beat < 4; beat += 1) click(start + beat * quarter, beat === 0 ? 1100 : 880, 0.12);
        const phraseStart = start + 4 * quarter;
        [...playedPattern].forEach((value, index) => {
          if (value === '1') click(phraseStart + index * slot, 660, 0.16);
        });

        if (status) {
          status.textContent = mode === 'full'
            ? hasChunks
              ? 'Escucha el conjunto. Si una parte no está clara, usa sólo los chunks que aporten información y vuelve después al estímulo completo.'
              : 'Escucha sin mirar la respuesta. Puedes repetir el estímulo antes de escribir.'
            : `Ayuda utilizada: ${chunkLabels[chunkIndex] ?? 'chunk'}. Después vuelve a escuchar el estímulo completo.`;
        }
        window.setTimeout(() => void context.close(), Math.ceil((4 * quarter + playedPattern.length * slot + 0.4) * 1000));
      };

      reveal?.addEventListener('click', () => {
        if (!answerText) return;
        const showing = answerText.hidden;
        answerText.hidden = !showing;
        answerText.textContent = showing ? answer : '';
        if (showing) {
          const score = ensureAnswerScore();
          if (score) score.hidden = false;
        } else if (answerScore) {
          answerScore.hidden = true;
        }
        reveal.textContent = showing ? 'Ocultar respuesta' : 'Mostrar respuesta';
      });

      play?.addEventListener('click', () => void playPattern(pattern, 'full'));
      chunkButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const index = Number(button.dataset.chunkIndex ?? '-1');
          const chunkPattern = chunkPatterns[index];
          if (!chunkPattern) return;
          void playPattern(chunkPattern, 'chunk', index);
        });
      });
    }
  };

  setupRhythmDictations();
  document.addEventListener('astro:page-load', setupRhythmDictations);
</script>

<style is:global>
  .rhythm-dictation{max-width:46rem;margin:1.25rem 0;padding:1rem;border:1px solid var(--border);border-radius:.85rem;background:var(--surface-2)}
  .rhythm-dictation__controls,.rhythm-dictation__chunks{display:flex;flex-wrap:wrap;align-items:center;gap:.65rem}
  .rhythm-dictation__chunks{margin-top:.75rem;padding-top:.75rem;border-top:1px solid var(--border)}
  .rhythm-dictation__chunks-label{width:100%;font-size:.9rem;font-weight:700;color:var(--muted)}
  .rhythm-dictation__controls button,.rhythm-dictation__chunks button{min-height:2.6rem;padding:.55rem .8rem;border:1px solid var(--border);border-radius:.6rem;background:var(--surface);color:var(--text);font:inherit;font-weight:650;cursor:pointer}
  .rhythm-dictation__chunks button:disabled{cursor:not-allowed;opacity:.5}
  .rhythm-dictation__status,.rhythm-dictation__listens,.rhythm-dictation__answer{margin:.75rem 0 0;color:var(--muted)}
  .rhythm-dictation__listens{font-size:.9rem;font-variant-numeric:tabular-nums}
  .rhythm-dictation__answer{font-weight:700;color:var(--text)}
  .rhythm-dictation [data-dictation-answer-score]{max-width:none;margin-top:1rem}
</style>
