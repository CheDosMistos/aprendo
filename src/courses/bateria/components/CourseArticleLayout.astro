---
import BaseLayout from '@platform/layouts/BaseLayout.astro';
import Metronome from '@platform/components/MetronomeCompact.astro';
import InlineNotationScores from '@platform/components/InlineNotationScores.astro';
import RhythmDictationWidgets from '@courses/bateria/components/RhythmDictationWidgets.astro';
import NotationStudyModes from '@courses/bateria/components/NotationStudyModes.astro';
import PracticeRecorder from '@courses/bateria/components/PracticeRecorder.astro';

interface NavItem { href: string; label: string; }
interface Props { title:string; summary:string; unitLabel:string; kindLabel?:string; duration?:string; previous?:NavItem; next?:NavItem; }
const { title, summary, unitLabel, kindLabel, duration, previous, next } = Astro.props;
---

<BaseLayout title={`${title} — Curso de batería`} description={summary}>
  <div class="course-page">
    <nav class="breadcrumbs" aria-label="Ruta"><a href="/bateria/">Batería</a><span aria-hidden="true">›</span><span>{unitLabel}</span></nav>
    <header class="article-header">
      <p class="eyebrow">{unitLabel}{kindLabel ? ` · ${kindLabel}` : ''}</p>
      <h1>{title}</h1><p class="summary">{summary}</p>{duration && <p class="duration">{duration}</p>}
    </header>

    <div class="learning-layout">
      <div class="learning-main">
        <article class="course-article"><slot /></article>
        <slot name="after" />
        {(previous || next) && (
          <nav class="lesson-nav" aria-label="Navegación de la unidad">
            <div>{previous && <a href={previous.href}>← {previous.label}</a>}</div>
            <div class="next-link">{next && <a href={next.href}>{next.label} →</a>}</div>
          </nav>
        )}
      </div>
      <aside class="learning-tools" id="course-metronome-panel" aria-label="Herramientas de práctica">
        <Metronome />
        <PracticeRecorder />
        <a class="progress-shortcut" href="/bateria/progreso/">Progreso y evidencia →</a>
      </aside>
      <button class="metronome-mobile-backdrop" type="button" data-metronome-backdrop aria-label="Ocultar metrónomo"></button>
    </div>
  </div>
  <InlineNotationScores />
  <NotationStudyModes />
  <RhythmDictationWidgets />
</BaseLayout>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>('.course-article a')) {
    try {
      const url = new URL(link.href, window.location.href);
      if (url.origin !== window.location.origin) {
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
      }
    } catch {}
  }
</script>

<style>
.course-page{width:100%;margin-inline:auto}.breadcrumbs{display:flex;gap:.5rem;align-items:center;margin-bottom:1.5rem;color:var(--muted);font-size:.92rem}.breadcrumbs a,.course-article :global(a),.lesson-nav a,.progress-shortcut{color:#0000ee;text-decoration:underline;text-underline-offset:.16em}:global(:root[data-theme='dark']) .breadcrumbs a,:global(:root[data-theme='dark']) .course-article :global(a),:global(:root[data-theme='dark']) .lesson-nav a,:global(:root[data-theme='dark']) .progress-shortcut{color:#8ab4f8}@media(prefers-color-scheme:dark){:global(:root:not([data-theme])) .breadcrumbs a,:global(:root:not([data-theme])) .course-article :global(a),:global(:root:not([data-theme])) .lesson-nav a,:global(:root:not([data-theme])) .progress-shortcut{color:#8ab4f8}}.article-header{max-width:60rem;margin-bottom:2rem}.summary{max-width:62ch;font-size:clamp(1rem,1.4vw,1.15rem)}.duration{width:fit-content;margin:0;padding:.35rem .6rem;border:1px solid var(--border);border-radius:999px;background:var(--surface-2);color:var(--text);font-size:.88rem;font-weight:650}.learning-layout{display:grid;grid-template-columns:minmax(0,3fr) minmax(14rem,1fr);align-items:start;gap:clamp(1.25rem,2.5vw,3rem)}.learning-main{min-width:0}.learning-main :global(.practice-checkin),.learning-main :global(.pas-map){width:100%;max-width:none}.learning-tools{position:sticky;top:5rem;z-index:1}.progress-shortcut{display:inline-flex;margin-top:.8rem;font-size:.9rem;font-weight:700}.metronome-mobile-backdrop{display:none}.course-article{width:100%;max-width:none;font-size:1.08rem;line-height:1.72}.course-article :global(h2){margin-top:2.4rem;margin-bottom:.75rem;font-size:clamp(1.35rem,2vw,1.7rem)}.course-article :global(h3){margin-top:1.8rem;margin-bottom:.5rem;font-size:1.08rem}.course-article :global(p),.course-article :global(li){color:var(--text)}.course-article :global(p),.course-article :global(ul),.course-article :global(ol),.course-article :global(blockquote),.course-article :global(h2),.course-article :global(h3){max-width:72ch}.course-article :global(ul),.course-article :global(ol){padding-left:1.35rem}.course-article :global(blockquote){margin:1.5rem 0;padding:.25rem 1rem;border-left:.25rem solid var(--border);color:var(--muted)}.lesson-nav{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:3rem;padding-top:1.25rem;border-top:1px solid var(--border)}.lesson-nav a{min-height:2.75rem;display:inline-flex;align-items:center;font-weight:650}.next-link{text-align:right}@media(max-width:64rem){.learning-layout{grid-template-columns:minmax(0,3fr) minmax(13rem,1fr);gap:1.1rem}}@media(max-width:56rem){.learning-layout{grid-template-columns:1fr}.learning-tools{display:none;position:fixed;left:50%;top:50%;width:min(22rem,calc(100vw - 2rem));max-height:calc(100dvh - 6rem);overflow-y:auto;transform:translate(-50%,-50%);z-index:20;margin:0;padding:.5rem;background:var(--bg);border-radius:var(--radius)}.learning-tools.is-mobile-open{display:block}.metronome-mobile-backdrop{position:fixed;inset:4rem 0 0;z-index:15;width:100%;height:auto;margin:0;padding:0;border:0;background:rgba(0,0,0,.46);backdrop-filter:blur(2px);cursor:pointer}.metronome-mobile-backdrop.is-open{display:block}.learning-tools :global(.metronome){max-width:none;box-shadow:0 1.2rem 3rem rgba(0,0,0,.28)}}@media(max-width:42rem){.course-page{width:100%}.article-header{margin-bottom:1.35rem}.lesson-nav{grid-template-columns:1fr}.next-link{text-align:left}.learning-tools{width:min(21rem,calc(100vw - 1.25rem));max-height:calc(100dvh - 5.25rem)}}
</style>
