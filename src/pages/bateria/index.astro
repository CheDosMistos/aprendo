---
import BaseLayout from '@platform/layouts/BaseLayout.astro';
import { bateriaCourse } from '@courses/bateria/course.config';
import { getBateriaContent, routeFor, unitEntries } from '@courses/bateria/contentRegistry';

const entries = await getBateriaContent();
const units = entries.filter((entry) => entry.data.kind === 'unit');

const sectionLabel = (kind: string) => {
  if (kind === 'diagnostic') return 'Diagnóstico';
  if (kind === 'checkpoint') return 'Cierre';
  return 'Lección';
};
---

<BaseLayout title={`${bateriaCourse.title} — Aprendo`} description={bateriaCourse.description}>
  <div class="stack course-home">
    <section>
      <p class="eyebrow">Aprendo · Batería</p>
      <h1>{bateriaCourse.title}</h1>
      <p>Estudia por unidades flexibles. La referencia de práctica es 25–30 minutos, 3–4 días por semana, sin deuda por calendario.</p>
    </section>

    <section class="unit-grid" aria-label="Unidades disponibles">
      {units.map((unit) => {
        const sections = unitEntries(entries, unit.data.phase, unit.data.unit)
          .filter((entry) => entry.data.kind !== 'unit');
        const firstSection = sections[0];

        return (
          <article class="unit-card">
            <p class="eyebrow">Fase {unit.data.phase} · Unidad {unit.data.unit}</p>
            <h2>{unit.data.title}</h2>
            <p>{unit.data.summary}</p>

            {sections.length > 0 && (
              <nav class="section-index" aria-label={`Secciones de la unidad ${unit.data.unit}`}>
                <h3>Secciones</h3>
                <ol>
                  {sections.map((section) => (
                    <li>
                      <a href={routeFor(section)}>
                        <span class="section-kind">{sectionLabel(section.data.kind)}</span>
                        <span>{section.data.title}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )}

            <div class="unit-actions">
              <a class="primary-link" href={routeFor(unit)}>Ver unidad</a>
              {firstSection && <a href={routeFor(firstSection)}>Empezar unidad</a>}
            </div>
          </article>
        );
      })}
    </section>
  </div>
</BaseLayout>

<style>
  .course-home {
    width: min(100%, 76rem);
    margin-inline: auto;
  }

  .unit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
  }

  .unit-card {
    min-height: 18rem;
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .unit-card h2 {
    margin-bottom: 0.65rem;
    font-size: clamp(1.35rem, 2vw, 1.65rem);
  }

  .section-index {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .section-index h3 {
    margin: 0 0 0.7rem;
    font-size: 0.92rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .section-index ol {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .section-index a {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.55rem;
    align-items: baseline;
    color: inherit;
    text-decoration: none;
  }

  .section-index a:hover span:last-child,
  .section-index a:focus-visible span:last-child {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .section-kind {
    min-width: 4.8rem;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .unit-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .unit-actions a:not(.primary-link) {
    color: #0000ee;
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  :global(:root[data-theme='dark']) .unit-actions a:not(.primary-link) {
    color: #8ab4f8;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .unit-actions a:not(.primary-link) {
      color: #8ab4f8;
    }
  }

  .primary-link {
    min-height: 2.8rem;
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 0.9rem;
    border-radius: 0.65rem;
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 750;
    text-decoration: none;
  }

  @media (max-width: 34rem) {
    .section-index a {
      grid-template-columns: 1fr;
      gap: 0.05rem;
    }
  }
</style>
