---
import BaseLayout from '@platform/layouts/BaseLayout.astro';
import { bateriaCourse } from '@courses/bateria/course.config';
import { getBateriaContent, routeFor, unitEntries } from '@courses/bateria/contentRegistry';

const entries = await getBateriaContent();
const units = entries.filter((entry) => entry.data.kind === 'unit');

const sectionLabel = (kind: string) => {
  if (kind === 'diagnostic') return 'Diagnóstico';
  if (kind === 'checkpoint') return 'Cierre';
  return 'Lección';
};
---

<BaseLayout title={`${bateriaCourse.title} — Aprendo`} description={bateriaCourse.description}>
  <div class="stack course-home" data-course-home>
    <section class="course-intro">
      <div>
        <p class="eyebrow">Aprendo · Batería</p>
        <h1>{bateriaCourse.title}</h1>
        <p>Estudia por unidades flexibles. La referencia de práctica es 25–30 minutos, 3–4 días por semana, sin deuda por calendario.</p>
      </div>
      <a class="progress-link" href="/bateria/progreso/">Ver progreso y evidencia</a>
    </section>

    <p class="course-status" data-course-status role="status" aria-live="polite">Cargando estado de práctica…</p>

    <section class="unit-grid" aria-label="Unidades disponibles">
      {units.map((unit) => {
        const sections = unitEntries(entries, unit.data.phase, unit.data.unit).filter((entry) => entry.data.kind !== 'unit');
        const firstSection = sections[0];
        return (
          <article class="unit-card" data-unit-card>
            <div class="unit-card__head">
              <p class="eyebrow">Fase {unit.data.phase} · Unidad {unit.data.unit}</p>
              <span class="unit-state" data-unit-state>Pendiente</span>
            </div>
            <h2>{unit.data.title}</h2>
            <p>{unit.data.summary}</p>

            {sections.length > 0 && (
              <nav class="section-index" aria-label={`Secciones de la unidad ${unit.data.unit}`}>
                <h3>Secciones</h3>
                <ol>
                  {sections.map((section) => (
                    <li data-content-id={section.data.contentId}>
                      <a href={routeFor(section)}>
                        <span class="section-kind">{sectionLabel(section.data.kind)}</span>
                        <span>{section.data.title}</span>
                        <span class="section-state" data-section-state aria-label="Estado">•</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )}

            <div class="unit-actions">
              <a class="primary-link" href={routeFor(unit)}>Ver unidad</a>
              {firstSection && <a href={routeFor(firstSection)}>Empezar unidad</a>}
            </div>
          </article>
        );
      })}
    </section>
  </div>
</BaseLayout>

<script>
  interface ProgressResponse { summary?: { completedContentIds?:string[]; needsReviewContentIds?:string[] }; }
  const home=document.querySelector<HTMLElement>('[data-course-home]');
  if(home){
    try{
      const response=await fetch('/api/progress/bateria/?limit=1');
      const body=await response.json() as ProgressResponse;
      if(!response.ok) throw new Error('load failed');
      const completed=new Set(body.summary?.completedContentIds??[]);
      const review=new Set(body.summary?.needsReviewContentIds??[]);
      for(const card of home.querySelectorAll<HTMLElement>('[data-unit-card]')){
        const rows=[...card.querySelectorAll<HTMLElement>('[data-content-id]')];
        let done=0,needsReview=0;
        for(const row of rows){
          const id=row.dataset.contentId??'';const marker=row.querySelector<HTMLElement>('[data-section-state]');
          if(completed.has(id)){done++;row.dataset.state='complete';if(marker){marker.textContent='✓';marker.title='Disponible';}}
          else if(review.has(id)){needsReview++;row.dataset.state='review';if(marker){marker.textContent='↺';marker.title='En revisión';}}
          else if(marker){marker.textContent='•';marker.title='Pendiente';}
        }
        const unitState=card.querySelector<HTMLElement>('[data-unit-state]');
        if(unitState){
          if(rows.length>0&&done===rows.length){unitState.textContent='Disponible';card.dataset.state='complete';}
          else if(done>0||needsReview>0){unitState.textContent=needsReview?`${done}/${rows.length} · revisión`:`${done}/${rows.length}`;card.dataset.state='active';}
        }
      }
      const status=home.querySelector<HTMLElement>('[data-course-status]');if(status)status.textContent=`${completed.size} sesiones disponibles · ${review.size} en revisión.`;
    }catch{const status=home.querySelector<HTMLElement>('[data-course-status]');if(status)status.textContent='No se pudo cargar el estado guardado.';}
  }
</script>

<style>
  .course-home{width:min(100%,76rem);margin-inline:auto}.course-intro{display:flex;justify-content:space-between;gap:1.25rem;align-items:flex-end}.course-intro>div{max-width:72ch}.progress-link{min-height:2.8rem;display:inline-flex;align-items:center;padding:.6rem .9rem;border:1px solid var(--border);border-radius:.65rem;color:var(--text);font-weight:750;text-decoration:none;white-space:nowrap}.progress-link:hover{border-color:var(--accent)}.course-status{margin:0;color:var(--muted);font-size:.9rem}.unit-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,22rem),1fr));gap:1rem}.unit-card{min-height:18rem;display:flex;flex-direction:column;padding:1.25rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface)}.unit-card[data-state='active']{border-color:color-mix(in srgb,var(--accent) 45%,var(--border))}.unit-card__head{display:flex;justify-content:space-between;gap:.7rem;align-items:flex-start}.unit-state{padding:.2rem .45rem;border-radius:999px;background:var(--surface-2);color:var(--muted);font-size:.75rem;font-weight:750}.unit-card[data-state='complete'] .unit-state{color:var(--text);border:1px solid var(--border)}.unit-card h2{margin-bottom:.65rem;font-size:clamp(1.35rem,2vw,1.65rem)}.section-index{margin-top:1.25rem;padding-top:1rem;border-top:1px solid var(--border)}.section-index h3{margin:0 0 .7rem;font-size:.92rem;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}.section-index ol{display:grid;gap:.45rem;margin:0;padding:0;list-style:none}.section-index a{display:grid;grid-template-columns:auto 1fr auto;gap:.55rem;align-items:baseline;color:inherit;text-decoration:none}.section-index a:hover span:nth-child(2),.section-index a:focus-visible span:nth-child(2){text-decoration:underline;text-underline-offset:.16em}.section-kind{min-width:4.8rem;color:var(--muted);font-size:.78rem;font-weight:700}.section-state{width:1.4rem;text-align:center;color:var(--muted);font-weight:800}.section-index li[data-state='complete'] .section-state{color:var(--text)}.section-index li[data-state='review'] .section-state{color:var(--accent)}.unit-actions{display:flex;flex-wrap:wrap;gap:.75rem 1rem;align-items:center;margin-top:auto;padding-top:1.25rem}.unit-actions a:not(.primary-link){color:#0000ee;text-decoration:underline;text-underline-offset:.16em}:global(:root[data-theme='dark']) .unit-actions a:not(.primary-link){color:#8ab4f8}@media(prefers-color-scheme:dark){:global(:root:not([data-theme])) .unit-actions a:not(.primary-link){color:#8ab4f8}}.primary-link{min-height:2.8rem;display:inline-flex;align-items:center;padding:.6rem .9rem;border-radius:.65rem;background:var(--accent);color:var(--accent-contrast);font-weight:750;text-decoration:none}@media(max-width:48rem){.course-intro{display:block}.progress-link{margin-top:.8rem}}@media(max-width:34rem){.section-index a{grid-template-columns:1fr auto;gap:.05rem .4rem}.section-kind{grid-column:1}.section-index a span:nth-child(2){grid-column:1}.section-state{grid-column:2;grid-row:1/3;align-self:center}}
</style>
