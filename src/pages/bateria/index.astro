---
import BaseLayout from '@platform/layouts/BaseLayout.astro';
import { bateriaCourse } from '@courses/bateria/course.config';
import { getBateriaContent, routeFor, unitEntries } from '@courses/bateria/contentRegistry';

const entries = await getBateriaContent();
const units = entries.filter((entry) => entry.data.kind === 'unit');
const phases = [...new Set(units.map((unit) => unit.data.phase))].sort((a, b) => a - b);
const coursePhases = Array.from({ length: 7 }, (_, index) => index + 1);
const initialPhase = phases[0] ?? 1;

const sectionLabel = (kind: string, lessonNumber?: number) => {
  if (kind === 'diagnostic') return 'Diagnóstico';
  if (kind === 'checkpoint') return 'Cierre';
  return `Lección ${lessonNumber ?? ''}`.trim();
};

const sectionTitle = (kind: string, title: string) => {
  if (kind === 'lesson') return title.replace(/^Lección\s+\d+\s*[—–-]\s*/u, '');
  if (kind === 'checkpoint') return title.replace(/^Cierre(?:\s+de\s+U\d+)?\s*[—–-]\s*/iu, '');
  if (kind === 'diagnostic') return title.replace(/^Diagnóstico\s*[—–-]\s*/iu, '');
  return title;
};
---

<BaseLayout title={`${bateriaCourse.title} — Aprendo`} description={bateriaCourse.description}>
  <div class="stack course-home" data-course-home>
    <section class="course-intro">
      <div>
        <p class="eyebrow">Aprendo · Batería</p>
        <h1>{bateriaCourse.title}</h1>
        <p>Estudia por unidades flexibles. La referencia de práctica es 25–30 minutos, 3–4 días por semana, sin deuda por calendario.</p>
      </div>
      <nav class="course-links" aria-label="Herramientas del curso">
        <a class="progress-link" href="/bateria/progreso/">Ver progreso y evidencia</a>
        <a class="progress-link" href="/bateria/apendices/">Apéndices</a>
      </nav>
    </section>

    <p class="course-status" data-course-status role="status" aria-live="polite">Cargando estado de práctica…</p>

    <nav class="phase-tabs" role="tablist" aria-label="Fases del curso" data-phase-tabs>
      {coursePhases.map((phase) => {
        const available = phases.includes(phase);
        const selected = phase === initialPhase;
        return (
          <button
            class="phase-tab"
            type="button"
            role="tab"
            id={`fase-${phase}-tab`}
            aria-controls={available ? `fase-${phase}-panel` : undefined}
            aria-selected={available ? selected : false}
            aria-label={available ? `Fase ${phase}` : `Fase ${phase} — próximamente`}
            data-phase-tab={phase}
            tabindex={available && selected ? 0 : -1}
            disabled={!available}
            title={available ? undefined : 'Próximamente'}
          >
            Fase {phase}
          </button>
        );
      })}
    </nav>

    <div class="phase-groups">
      {phases.map((phase) => {
        const phaseUnits = units.filter((unit) => unit.data.phase === phase);
        return (
          <section
            class="phase-group"
            id={`fase-${phase}-panel`}
            role="tabpanel"
            tabindex="0"
            aria-labelledby={`fase-${phase}-tab`}
            data-phase-group={phase}
            data-phase-panel={phase}
            hidden={phase !== initialPhase}
          >
            <div class="unit-grid" aria-label={`Unidades de la fase ${phase}`}>
              {phaseUnits.map((unit) => {
                const sections = unitEntries(entries, unit.data.phase, unit.data.unit).filter((entry) => entry.data.kind !== 'unit');
                const firstSection = sections[0];
                let lessonNumber = 0;
                return (
                  <article class="unit-card" data-unit-card data-unit-route={routeFor(unit)}>
                    <div class="unit-card__head">
                      <p class="eyebrow">Fase {unit.data.phase} · Unidad {unit.data.unit}</p>
                      <span class="unit-state" data-unit-state>Pendiente</span>
                    </div>
                    <h3>{unit.data.title}</h3>
                    <p>{unit.data.summary}</p>

                    {sections.length > 0 && (
                      <nav class="section-index" aria-label={`Secciones de la unidad ${unit.data.unit}`}>
                        <ol>
                          {sections.map((section) => {
                            const number = section.data.kind === 'lesson' ? ++lessonNumber : undefined;
                            return (
                              <li data-content-id={section.data.contentId}>
                                <a href={routeFor(section)}>
                                  <span class="section-kind">{sectionLabel(section.data.kind, number)}</span>
                                  <span class="section-title">{sectionTitle(section.data.kind, section.data.title)}</span>
                                </a>
                              </li>
                            );
                          })}
                        </ol>
                      </nav>
                    )}

                    <div class="unit-actions">
                      <a
                        class="primary-link"
                        data-unit-action
                        href={firstSection ? routeFor(firstSection) : routeFor(unit)}
                      >
                        {firstSection ? 'Empezar unidad' : 'Ver unidad'}
                      </a>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>

<script>
  interface ProgressResponse { summary?: { completedContentIds?:string[]; needsReviewContentIds?:string[] }; }

  const home=document.querySelector<HTMLElement>('[data-course-home]');
  if(home){
    const tabList=home.querySelector<HTMLElement>('[data-phase-tabs]');
    const tabs=[...home.querySelectorAll<HTMLButtonElement>('[data-phase-tab]')];
    const panels=[...home.querySelectorAll<HTMLElement>('[data-phase-panel]')];
    const enabledTabs=tabs.filter((tab)=>!tab.disabled);

    const activatePhase=(phase:string, options:{focus?:boolean;updateHash?:boolean}={})=>{
      const tab=tabs.find((item)=>item.dataset.phaseTab===phase&&!item.disabled);
      const panel=panels.find((item)=>item.dataset.phasePanel===phase);
      if(!tab||!panel)return;

      for(const item of tabs){
        const active=item===tab;
        item.setAttribute('aria-selected',String(active));
        item.tabIndex=active?0:-1;
      }
      for(const item of panels)item.hidden=item!==panel;

      if(options.focus)tab.focus();
      if(options.updateHash){
        const next=`${window.location.pathname}${window.location.search}#fase-${phase}`;
        window.history.replaceState(null,'',next);
      }
    };

    const phaseFromHash=()=>{
      const match=window.location.hash.match(/^#fase-(\d+)$/);
      return match?.[1];
    };

    const requestedPhase=phaseFromHash();
    if(requestedPhase)activatePhase(requestedPhase);

    tabList?.addEventListener('click',(event)=>{
      const target=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-phase-tab]');
      if(!target||target.disabled)return;
      activatePhase(target.dataset.phaseTab??'',{updateHash:true});
    });

    tabList?.addEventListener('keydown',(event)=>{
      if(!(event instanceof KeyboardEvent))return;
      const current=document.activeElement instanceof HTMLButtonElement?document.activeElement:null;
      const currentIndex=current?enabledTabs.indexOf(current):-1;
      if(currentIndex<0)return;

      let nextIndex=currentIndex;
      if(event.key==='ArrowRight')nextIndex=(currentIndex+1)%enabledTabs.length;
      else if(event.key==='ArrowLeft')nextIndex=(currentIndex-1+enabledTabs.length)%enabledTabs.length;
      else if(event.key==='Home')nextIndex=0;
      else if(event.key==='End')nextIndex=enabledTabs.length-1;
      else return;

      event.preventDefault();
      const nextTab=enabledTabs[nextIndex];
      activatePhase(nextTab.dataset.phaseTab??'',{focus:true,updateHash:true});
    });

    window.addEventListener('hashchange',()=>{
      const phase=phaseFromHash();
      if(phase)activatePhase(phase);
    });

    try{
      const response=await fetch('/api/progress/bateria/?limit=1');
      const body=await response.json() as ProgressResponse;
      if(!response.ok) throw new Error('load failed');
      const completed=new Set(body.summary?.completedContentIds??[]);
      const review=new Set(body.summary?.needsReviewContentIds??[]);
      for(const card of home.querySelectorAll<HTMLElement>('[data-unit-card]')){
        const rows=[...card.querySelectorAll<HTMLElement>('[data-content-id]')];
        let done=0,needsReview=0;
        for(const row of rows){
          const id=row.dataset.contentId??'';
          if(completed.has(id)){done++;row.dataset.state='complete';}
          else if(review.has(id)){needsReview++;row.dataset.state='review';}
          else row.dataset.state='pending';
        }
        const unitState=card.querySelector<HTMLElement>('[data-unit-state]');
        const action=card.querySelector<HTMLAnchorElement>('[data-unit-action]');
        if(rows.length>0&&done===rows.length){
          card.dataset.state='complete';
          if(unitState)unitState.textContent='Disponible';
          if(action){action.textContent='Ver unidad';action.href=card.dataset.unitRoute??action.href;}
        }
        else if(done>0||needsReview>0){
          card.dataset.state='active';
          if(unitState)unitState.textContent=needsReview?`${done}/${rows.length} · revisión`:`${done}/${rows.length}`;
          const nextRow=rows.find((row)=>row.dataset.state!=='complete');
          const nextLink=nextRow?.querySelector<HTMLAnchorElement>('a');
          const nextHref=nextLink?.getAttribute('href');
          if(action){action.textContent='Continuar unidad';if(nextHref)action.setAttribute('href',nextHref);}
        }
      }
      const status=home.querySelector<HTMLElement>('[data-course-status]');if(status)status.textContent=`${completed.size} sesiones disponibles · ${review.size} en revisión.`;
    }catch{const status=home.querySelector<HTMLElement>('[data-course-status]');if(status)status.textContent='No se pudo cargar el estado guardado.';}
  }
</script>

<style>
  .course-home{width:min(100%,76rem);margin-inline:auto}.course-intro{display:flex;justify-content:space-between;gap:1.25rem;align-items:flex-end}.course-intro>div{max-width:72ch}.course-links{display:flex;gap:.6rem;align-items:center;flex-wrap:wrap;justify-content:flex-end}.progress-link{min-height:2.8rem;display:inline-flex;align-items:center;padding:.6rem .9rem;border:1px solid var(--border);border-radius:.65rem;color:var(--text);font-weight:750;text-decoration:none;white-space:nowrap}.progress-link:hover{border-color:var(--accent)}.course-status{margin:0;color:var(--muted);font-size:.9rem}.phase-tabs{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:.35rem;padding:.35rem;border:1px solid var(--border);border-radius:.85rem;background:var(--surface-2)}.phase-tab{min-height:2.8rem;border:0;border-radius:.6rem;background:transparent;color:var(--muted);font:inherit;font-size:.9rem;font-weight:800;cursor:pointer;white-space:nowrap}.phase-tab:hover:not(:disabled){background:var(--surface);color:var(--text)}.phase-tab:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.phase-tab[aria-selected='true']{background:var(--accent);color:var(--accent-contrast)}.phase-tab:disabled{cursor:not-allowed;opacity:.42}.phase-groups{display:grid}.phase-group{display:grid}.phase-group[hidden]{display:none}.unit-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.85rem}.unit-card{min-height:16rem;display:flex;flex-direction:column;padding:1rem 1.05rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface)}.unit-card[data-state='active']{border-color:color-mix(in srgb,var(--accent) 45%,var(--border))}.unit-card__head{display:flex;justify-content:space-between;gap:.7rem;align-items:flex-start}.unit-card__head .eyebrow{margin-bottom:.2rem}.unit-state{padding:.2rem .45rem;border-radius:999px;background:var(--surface-2);color:var(--muted);font-size:.75rem;font-weight:750}.unit-card[data-state='complete'] .unit-state{color:var(--text);border:1px solid var(--border)}.unit-card h3{margin-top:.35rem;margin-bottom:.45rem;font-size:clamp(1.35rem,2vw,1.65rem)}.unit-card>p{margin-bottom:0}.section-index{margin-top:.9rem;padding-top:.75rem;border-top:1px solid var(--border)}.section-index ol{display:grid;gap:.35rem;margin:0;padding:0;list-style:none}.section-index a{display:grid;grid-template-columns:minmax(5.4rem,auto) minmax(0,1fr);gap:.5rem;align-items:baseline;color:inherit;text-decoration:none}.section-index a:hover .section-title,.section-index a:focus-visible .section-title{text-decoration:underline;text-underline-offset:.16em}.section-kind{color:var(--muted);font-size:.78rem;font-weight:700}.section-index li[data-state='complete'] .section-kind{color:var(--text)}.section-index li[data-state='review'] .section-kind{color:var(--accent)}.unit-actions{display:flex;align-items:center;margin-top:auto;padding-top:.9rem}.primary-link{min-height:2.8rem;display:inline-flex;align-items:center;padding:.6rem .9rem;border-radius:.65rem;background:var(--accent);color:var(--accent-contrast);font-weight:750;text-decoration:none}@media(max-width:48rem){.course-intro{display:block}.course-links{justify-content:flex-start;margin-top:.8rem}.phase-tabs{display:flex;overflow-x:auto;overscroll-behavior-inline:contain;scroll-snap-type:x proximity;scrollbar-width:thin;-webkit-overflow-scrolling:touch}.phase-tab{flex:0 0 auto;min-width:6.4rem;scroll-snap-align:start}.unit-grid{grid-template-columns:1fr;gap:.75rem}.unit-card{min-height:0;padding:1rem}}@media(max-width:34rem){.section-index a{grid-template-columns:5.4rem minmax(0,1fr);gap:.4rem}}
</style>
