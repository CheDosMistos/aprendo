---
import { render } from 'astro:content';
import CourseArticleLayout from '@courses/bateria/components/CourseArticleLayout.astro';
import PracticeCheckIn from '@courses/bateria/components/PracticeCheckIn.astro';
import Phase1PasMap from '@courses/bateria/components/Phase1PasMap.astro';
import RudimentNotationAutoEmbed from '@courses/bateria/components/RudimentNotationAutoEmbed.astro';
import CourseScoreReferences from '@platform/components/CourseScoreReferences.astro';
import {
  getBateriaContent,
  routeFor,
  unitEntries,
} from '@courses/bateria/contentRegistry';

interface NavItem {
  href: string;
  label: string;
}

const PAS_NORMATIVE_URL = 'https://pas.org/wp-content/uploads/2024/04/pas-rudiments.pdf';

const entries = await getBateriaContent();
const unitSlug = Astro.params.unit;
const slug = Astro.params.slug;
const entry = entries.find((candidate) =>
  candidate.data.kind !== 'unit' &&
  candidate.data.unitSlug === unitSlug &&
  candidate.data.slug === slug,
);

if (!entry) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const unit = unitEntries(entries, entry.data.phase, entry.data.unit);
const overview = unit.find((candidate) => candidate.data.kind === 'unit');
const sessions = unit.filter((candidate) => candidate.data.kind !== 'unit');
const index = sessions.findIndex((candidate) => candidate.data.contentId === entry.data.contentId);
const previousEntry = index > 0 ? sessions[index - 1] : overview;
const nextEntry = index >= 0 && index < sessions.length - 1 ? sessions[index + 1] : undefined;
const previous: NavItem | undefined = previousEntry
  ? { href: routeFor(previousEntry), label: previousEntry.data.title }
  : undefined;
const next: NavItem | undefined = nextEntry
  ? { href: routeFor(nextEntry), label: nextEntry.data.title }
  : undefined;

const { Content } = await render(entry);
const unitLabel = `Fase ${entry.data.phase} · Unidad ${entry.data.unit}`;
const kindLabel = entry.data.kind === 'diagnostic'
  ? 'Diagnóstico'
  : entry.data.kind === 'checkpoint'
    ? 'Cierre'
    : 'Lección';
const checkInKind = entry.data.kind === 'diagnostic' || entry.data.kind === 'lesson' || entry.data.kind === 'checkpoint'
  ? entry.data.kind
  : undefined;
const showPhase1PasMap = entry.data.contentId === 'bat-f1-u10-check';
const hasPasRudiments = entry.data.rudiments.length > 0;
---

<CourseArticleLayout
  title={entry.data.title}
  summary={entry.data.summary}
  unitLabel={unitLabel}
  kindLabel={kindLabel}
  duration={entry.data.duration}
  previous={previous}
  next={next}
>
  <Content />
  {hasPasRudiments && <RudimentNotationAutoEmbed rudiments={entry.data.rudiments} />}
  <CourseScoreReferences
    normativeReferenceUrl={hasPasRudiments ? PAS_NORMATIVE_URL : undefined}
    normativeReferenceLabel={hasPasRudiments ? 'PAS — International Drum Rudiments' : undefined}
  />

  {(showPhase1PasMap || checkInKind) && (
    <div slot="after">
      {showPhase1PasMap && <Phase1PasMap sourceContentId={entry.data.contentId} />}
      {checkInKind && (
        <PracticeCheckIn
          courseId={entry.data.courseId}
          contentId={entry.data.contentId}
          kind={checkInKind}
          next={next}
        />
      )}
    </div>
  )}
</CourseArticleLayout>
