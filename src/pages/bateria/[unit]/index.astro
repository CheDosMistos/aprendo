---
import { render } from 'astro:content';
import CourseArticleLayout from '@courses/bateria/components/CourseArticleLayout.astro';
import {
  getBateriaContent,
  routeFor,
  unitEntries,
  type BateriaContentEntry,
} from '@courses/bateria/contentRegistry';

interface Props {
  entry: BateriaContentEntry;
  sessions: BateriaContentEntry[];
}

export async function getStaticPaths() {
  const entries = await getBateriaContent();

  return entries
    .filter((entry) => entry.data.kind === 'unit')
    .map((entry) => ({
      params: { unit: entry.data.unitSlug },
      props: {
        entry,
        sessions: unitEntries(entries, entry.data.phase, entry.data.unit)
          .filter((candidate) => candidate.data.kind !== 'unit'),
      },
    }));
}

const { entry, sessions } = Astro.props;
const { Content } = await render(entry);
const unitLabel = `Fase ${entry.data.phase} · Unidad ${entry.data.unit}`;
---

<CourseArticleLayout
  title={entry.data.title}
  summary={entry.data.summary}
  unitLabel={unitLabel}
  duration={entry.data.duration}
>
  <Content />

  <section slot="after" class="session-list" aria-labelledby="session-list-title">
    <h2 id="session-list-title">Sesiones</h2>
    <div class="session-grid">
      {sessions.map((session) => (
        <a class="session-card" href={routeFor(session)}>
          <span class="session-kind">
            {session.data.kind === 'diagnostic'
              ? 'Diagnóstico'
              : session.data.kind === 'checkpoint'
                ? 'Cierre'
                : 'Lección'}
          </span>
          <strong>{session.data.title}</strong>
          <span>{session.data.summary}</span>
          {session.data.duration && <small>{session.data.duration}</small>}
        </a>
      ))}
    </div>
  </section>
</CourseArticleLayout>

<style>
  .session-list {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .session-list h2 {
    margin-bottom: 1rem;
  }

  .session-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 0.8rem;
  }

  .session-card {
    min-height: 10rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }

  .session-card:hover {
    border-color: var(--accent);
  }

  .session-card strong {
    font-size: 1.05rem;
  }

  .session-card span:not(.session-kind) {
    color: var(--muted);
    line-height: 1.5;
  }

  .session-kind {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .session-card small {
    margin-top: auto;
    color: var(--muted);
  }
</style>
