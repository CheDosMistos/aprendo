---
export const prerender = false;
const hasError = Astro.url.searchParams.get('error') === '1';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Aprendo</title>
  </head>
  <body>
    <main>
      <form method="post" action="/api/auth/login/" autocomplete="on">
        <input
          type="text"
          name="username"
          placeholder="Usuario"
          aria-label="Usuario"
          autocomplete="username"
          autocapitalize="none"
          spellcheck="false"
          enterkeyhint="next"
          required
          autofocus
        />
        <input
          type="password"
          name="password"
          placeholder="Contraseña"
          aria-label="Contraseña"
          autocomplete="current-password"
          enterkeyhint="go"
          required
        />
        {hasError && <span class="auth-error" aria-hidden="true">×</span>}
      </form>
    </main>

    <script is:inline>
      (() => {
        const form = document.querySelector('form');
        const username = form?.elements.namedItem('username');
        const password = form?.elements.namedItem('password');

        if (!(form instanceof HTMLFormElement)) return;
        if (!(username instanceof HTMLInputElement)) return;
        if (!(password instanceof HTMLInputElement)) return;

        let submitting = false;

        const submit = () => {
          if (submitting) return;
          submitting = true;
          form.requestSubmit();
          if (!form.checkValidity()) submitting = false;
        };

        password.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' || event.isComposing) return;
          event.preventDefault();
          submit();
        });

        password.addEventListener('blur', () => {
          if (username.value.trim() === '' || password.value === '') return;
          submit();
        });
      })();
    </script>
  </body>
</html>

<style>
  :root { color-scheme: light dark; }
  * { box-sizing: border-box; }
  html, body { min-height: 100%; margin: 0; }
  body {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    background: light-dark(#f7f7f5, #101010);
    color: light-dark(#151515, #f3f3f3);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  main { width: min(24rem, calc(100vw - 2rem)); }
  form { position: relative; display: grid; gap: .7rem; width: 100%; }
  input {
    width: 100%;
    min-height: 3.35rem;
    padding: .8rem 1rem;
    border: 1px solid light-dark(#cfcfca, #414141);
    border-radius: .65rem;
    outline: none;
    background: light-dark(#fff, #181818);
    color: inherit;
    font: inherit;
    font-size: 1rem;
    transition: border-color 120ms ease, box-shadow 120ms ease;
  }
  input::placeholder { color: light-dark(#777, #999); opacity: 1; }
  input:focus {
    border-color: light-dark(#777, #999);
    box-shadow: 0 0 0 2px light-dark(rgb(0 0 0 / .07), rgb(255 255 255 / .09));
  }
  .auth-error {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    color: #e12626;
    font: 700 4.5rem/1 system-ui, sans-serif;
    text-shadow: 0 1px 10px light-dark(rgb(255 255 255 / .8), rgb(0 0 0 / .65));
  }
</style>
