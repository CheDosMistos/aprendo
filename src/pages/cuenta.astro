---
import BaseLayout from '@platform/layouts/BaseLayout.astro';

export const prerender = false;
const user = Astro.locals.user!;
const avatarUrl = user.avatarVersion ? `/api/account/avatar/?v=${encodeURIComponent(user.avatarVersion)}` : null;
---

<BaseLayout title="Mi cuenta · Aprendo">
  <section class="account-shell">
    <header class="account-heading">
      <div class="avatar-wrap" data-avatar-wrap>
        <button class="avatar-editor" type="button" data-avatar-trigger aria-label="Cambiar imagen de usuario">
          {avatarUrl ? (
            <img src={avatarUrl} alt="Imagen de usuario" width="100" height="100" data-avatar-image />
          ) : (
            <span class="avatar-placeholder" data-avatar-placeholder>
              <svg aria-hidden="true"><use href="/ui/icons.svg#user"></use></svg>
            </span>
          )}
          <span class="avatar-edit-mark" aria-hidden="true">+</span>
        </button>
        <input type="file" accept="image/*" data-avatar-input hidden />
      </div>
      <div>
        <p class="eyebrow">Mi cuenta</p>
        <h1>{user.username}</h1>
        <p>{user.role === 'admin' ? 'Administrador' : 'Patán'}</p>
      </div>
    </header>

    <div class="account-grid">
      <form class="account-card" data-account-form>
        <h2>Acceso</h2>
        <label>
          <span>Login</span>
          <input name="username" value={user.username} autocomplete="username" required minlength="3" maxlength="40" />
        </label>
        <label>
          <span>Contraseña actual</span>
          <input name="currentPassword" type="password" autocomplete="current-password" required />
        </label>
        <label>
          <span>Nueva contraseña</span>
          <input name="newPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" placeholder="Déjala vacía para mantenerla" />
          <small>Solo se aplica si decides cambiarla: mínimo 8 caracteres.</small>
        </label>
        <label>
          <span>Repetir nueva contraseña</span>
          <input name="confirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" />
        </label>
        <div class="form-footer">
          <button type="submit">Guardar cambios</button>
          <span class="status" data-account-status aria-live="polite"></span>
        </div>
      </form>

      <section class="account-card avatar-card">
        <h2>Imagen</h2>
        <p>La imagen se recorta en el dispositivo y se guarda únicamente como WebP de 100×100 px muy comprimido.</p>
        <div class="avatar-actions">
          <button type="button" data-avatar-change>Cambiar imagen</button>
          {avatarUrl && <button class="secondary" type="button" data-avatar-remove>Eliminar</button>}
          <span class="status" data-avatar-status aria-live="polite"></span>
        </div>
      </section>
    </div>

    <form method="post" action="/api/auth/logout/" class="logout-form">
      <button type="submit">Cerrar sesión</button>
    </form>
  </section>
</BaseLayout>

<script>
  const accountForm = document.querySelector<HTMLFormElement>('[data-account-form]');
  const accountStatus = document.querySelector<HTMLElement>('[data-account-status]');
  const avatarInput = document.querySelector<HTMLInputElement>('[data-avatar-input]');
  const avatarTrigger = document.querySelector<HTMLButtonElement>('[data-avatar-trigger]');
  const avatarChange = document.querySelector<HTMLButtonElement>('[data-avatar-change]');
  const avatarRemove = document.querySelector<HTMLButtonElement>('[data-avatar-remove]');
  const avatarStatus = document.querySelector<HTMLElement>('[data-avatar-status]');

  accountForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!accountStatus) return;
    accountStatus.textContent = '';
    const data = new FormData(accountForm);
    const newPassword = String(data.get('newPassword') ?? '');
    const confirmPassword = String(data.get('confirmPassword') ?? '');
    if (newPassword !== confirmPassword) {
      accountStatus.textContent = 'Las contraseñas no coinciden.';
      accountStatus.dataset.kind = 'error';
      return;
    }

    try {
      const response = await fetch('/api/account/profile/', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          username: String(data.get('username') ?? ''),
          currentPassword: String(data.get('currentPassword') ?? ''),
          newPassword,
        }),
      });
      const body = await response.json() as { error?: string; user?: { username: string } };
      if (!response.ok) throw new Error(body.error || 'No se pudo actualizar la cuenta.');
      accountStatus.textContent = 'Guardado.';
      accountStatus.dataset.kind = 'ok';
      const current = accountForm.elements.namedItem('currentPassword') as HTMLInputElement | null;
      const next = accountForm.elements.namedItem('newPassword') as HTMLInputElement | null;
      const confirm = accountForm.elements.namedItem('confirmPassword') as HTMLInputElement | null;
      if (newPassword && current) current.value = newPassword;
      if (next) next.value = '';
      if (confirm) confirm.value = '';
      const heading = document.querySelector<HTMLHeadingElement>('.account-heading h1');
      if (heading && body.user?.username) heading.textContent = body.user.username;
    } catch (error) {
      accountStatus.textContent = error instanceof Error ? error.message : 'No se pudo actualizar la cuenta.';
      accountStatus.dataset.kind = 'error';
    }
  });

  const openAvatarPicker = () => avatarInput?.click();
  avatarTrigger?.addEventListener('click', openAvatarPicker);
  avatarChange?.addEventListener('click', openAvatarPicker);

  avatarInput?.addEventListener('change', async () => {
    const file = avatarInput.files?.[0];
    if (!file || !avatarStatus) return;
    avatarStatus.textContent = 'Procesando…';
    avatarStatus.dataset.kind = '';
    try {
      const blob = await makeAvatar(file);
      const form = new FormData();
      form.set('avatar', blob, 'avatar.webp');
      const response = await fetch('/api/account/avatar/', { method: 'POST', body: form });
      const body = await response.json() as { error?: string; avatarVersion?: string };
      if (!response.ok) throw new Error(body.error || 'No se pudo guardar la imagen.');
      const url = `/api/account/avatar/?v=${encodeURIComponent(body.avatarVersion ?? Date.now().toString())}`;
      let image = document.querySelector<HTMLImageElement>('[data-avatar-image]');
      const placeholder = document.querySelector<HTMLElement>('[data-avatar-placeholder]');
      if (!image) {
        image = document.createElement('img');
        image.width = 100;
        image.height = 100;
        image.alt = 'Imagen de usuario';
        image.dataset.avatarImage = '';
        placeholder?.replaceWith(image);
      }
      image.src = url;
      avatarStatus.textContent = 'Imagen guardada.';
      avatarStatus.dataset.kind = 'ok';
      if (!document.querySelector('[data-avatar-remove]')) location.reload();
    } catch (error) {
      avatarStatus.textContent = error instanceof Error ? error.message : 'No se pudo procesar la imagen.';
      avatarStatus.dataset.kind = 'error';
    } finally {
      avatarInput.value = '';
    }
  });

  avatarRemove?.addEventListener('click', async () => {
    if (!avatarStatus) return;
    try {
      const response = await fetch('/api/account/avatar/', { method: 'DELETE' });
      if (!response.ok) throw new Error('No se pudo eliminar la imagen.');
      location.reload();
    } catch (error) {
      avatarStatus.textContent = error instanceof Error ? error.message : 'No se pudo eliminar la imagen.';
      avatarStatus.dataset.kind = 'error';
    }
  });

  async function makeAvatar(file: File): Promise<Blob> {
    if (!file.type.startsWith('image/')) throw new Error('Selecciona una imagen válida.');
    if (file.size > 15 * 1024 * 1024) throw new Error('La imagen original es demasiado grande.');
    const bitmap = await createImageBitmap(file);
    try {
      const side = Math.min(bitmap.width, bitmap.height);
      const sx = Math.floor((bitmap.width - side) / 2);
      const sy = Math.floor((bitmap.height - side) / 2);
      const canvas = document.createElement('canvas');
      canvas.width = 100;
      canvas.height = 100;
      const context = canvas.getContext('2d', { alpha: false });
      if (!context) throw new Error('El navegador no puede procesar la imagen.');
      context.drawImage(bitmap, sx, sy, side, side, 0, 0, 100, 100);
      let blob = await canvasToWebp(canvas, 0.42);
      if (blob.size > 50 * 1024) blob = await canvasToWebp(canvas, 0.25);
      if (blob.size > 50 * 1024) throw new Error('No se pudo comprimir suficientemente la imagen.');
      return blob;
    } finally {
      bitmap.close();
    }
  }

  function canvasToWebp(canvas: HTMLCanvasElement, quality: number): Promise<Blob> {
    return new Promise((resolve, reject) => {
      canvas.toBlob((blob) => {
        if (!blob || blob.type !== 'image/webp') reject(new Error('Este navegador no permite guardar WebP.'));
        else resolve(blob);
      }, 'image/webp', quality);
    });
  }
</script>

<style>
  .account-shell { max-width: 60rem; margin: 2rem auto 4rem; }
  .account-heading { display: flex; align-items: center; gap: 1.25rem; margin-bottom: 2rem; }
  .account-heading h1 { margin: .15rem 0; font-size: clamp(2rem, 5vw, 3.2rem); }
  .account-heading p { margin: 0; color: var(--muted); }
  .eyebrow { text-transform: uppercase; letter-spacing: .12em; font-size: .75rem; font-weight: 800; }
  .avatar-editor { position: relative; width: 6.25rem; height: 6.25rem; padding: 0; border: 1px solid var(--border); border-radius: 50%; overflow: hidden; background: var(--surface-2); color: var(--text); cursor: pointer; }
  .avatar-editor img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .avatar-placeholder { width: 100%; height: 100%; display: grid; place-items: center; }
  .avatar-placeholder svg { width: 2.7rem; height: 2.7rem; opacity: .75; }
  .avatar-edit-mark { position: absolute; right: .25rem; bottom: .25rem; width: 1.6rem; height: 1.6rem; display: grid; place-items: center; border-radius: 50%; background: var(--text); color: var(--bg); font-weight: 900; }
  .account-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(15rem, .8fr); gap: 1rem; }
  .account-card { padding: 1.25rem; border: 1px solid var(--border); border-radius: 1rem; background: var(--surface); }
  .account-card h2 { margin-top: 0; }
  .account-card label { display: grid; gap: .35rem; margin-top: .9rem; font-weight: 700; }
  .account-card label small { color: var(--muted); font-weight: 400; }
  .account-card input { min-height: 2.9rem; padding: .65rem .8rem; border: 1px solid var(--border); border-radius: .6rem; background: var(--bg); color: var(--text); font: inherit; }
  .form-footer, .avatar-actions { display: flex; align-items: center; flex-wrap: wrap; gap: .8rem; margin-top: 1.2rem; }
  button { min-height: 2.75rem; padding: .65rem 1rem; border: 1px solid var(--border); border-radius: .65rem; background: var(--text); color: var(--bg); font: inherit; font-weight: 800; cursor: pointer; }
  button.secondary, .logout-form button { background: transparent; color: var(--text); }
  .avatar-card p { color: var(--muted); line-height: 1.55; }
  .status { min-height: 1.2em; color: var(--muted); font-size: .9rem; }
  .status[data-kind='error'] { color: #d83a3a; }
  .status[data-kind='ok'] { color: #2f8b57; }
  .logout-form { margin-top: 1rem; }
  @media (max-width: 44rem) { .account-grid { grid-template-columns: 1fr; } }
</style>
